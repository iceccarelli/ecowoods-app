+  id: `ch${chapter}-${String(order).padStart(2, '0')}`,
+  chapter,
+  order,
+  role,
+  alt,
+  src: `${P}/ch${chapter}/${String(order).padStart(2, '0')}_${file}.webp`,
+  width: 1920,
+  height: 1080,
+  kind: 'photograph',
+  origin,
+});
+
