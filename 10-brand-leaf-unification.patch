new file mode 100644
index 0000000..7724bed
--- /dev/null
+++ b/apps/web/app/icon.svg
@@ -0,0 +1,24 @@
+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
+  <!--
+    Ecowoods favicon. Next's App Router serves any app/icon.svg automatically
+    as <link rel="icon">, so the tab carries the same mark as the header.
+
+    Static hex is correct here: a favicon is rasterised by the browser chrome,
+    outside the page, where CSS custom properties do not exist. These are the
+    literal values of the walnut-800 to oak-500 tile gradient, and cream-50.
+    (An XML comment may not contain a double hyphen, so no var() names here.)
+  -->
+  <defs>
+    <linearGradient id="ew-tile" x1="0" y1="0" x2="1" y2="1">
+      <stop offset="0%" stop-color="#3a2418" />
+      <stop offset="100%" stop-color="#8b5e3c" />
+    </linearGradient>
+  </defs>
+
+  <rect x="0" y="0" width="64" height="64" rx="16" fill="url(#ew-tile)" />
+
+  <g transform="translate(14.67 14.67) scale(1.444)" fill="none" stroke="#faf6ef" stroke-width="1.6">
+    <path d="M12 2C9 6 6 8 6 12c0 3.5 2.5 6 6 6s6-2.5 6-6c0-4-3-6-6-10Z" fill="#faf6ef" fill-opacity="0.18" />
+    <path d="M12 4.5c-2 3-4 4.5-4 7.5 0 2.5 1.8 4.5 4 4.5" stroke-linecap="round" />
+  </g>
+</svg>
