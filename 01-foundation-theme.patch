+  filter: brightness(0.72) saturate(0.94);
+}
+
+html[data-theme='dark'] .gallery-tile:hover img,
+html[data-theme='dark'] .gallery-tile:focus-within img {
+  filter: brightness(0.92) saturate(1);
+}
+
+html[data-theme='dark'] .paper-texture {
+  background-color: var(--bg);
+}
+
+/* Theme is a preference, not an animation. Never fight reduced-motion. */
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+}
+
+/* ------------------------------------------------------------
+   Theme toggle (header)
+   ------------------------------------------------------------ */
+.theme-toggle {
+  display: inline-grid;
+  place-items: center;
+  height: 38px;
+  width: 38px;
+  border-radius: var(--radius-full);
+  border: 1px solid var(--line);
+  background: var(--surface-1);
+  color: var(--ink-soft);
+  transition: background 180ms var(--ease-out-quart), color 180ms var(--ease-out-quart),
+    border-color 180ms var(--ease-out-quart), transform 180ms var(--ease-out-quart);
+}
+
+.theme-toggle:hover {
+  color: var(--copper);
+  border-color: var(--copper);
+  transform: translateY(-1px);
+}
+
+.theme-toggle svg { height: 17px; width: 17px; }
+
+/* ------------------------------------------------------------
+   Command palette (⌘K)
+   ------------------------------------------------------------ */
+.cmdk-trigger {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  height: 38px;
+  padding: 0 0.7rem 0 0.75rem;
+  border-radius: var(--radius-full);
+  border: 1px solid var(--line);
+  background: var(--surface-1);
+  color: var(--muted);
+  font-size: 0.82rem;
+  transition: color 180ms var(--ease-out-quart), border-color 180ms var(--ease-out-quart);
+}
+
+.cmdk-trigger:hover { color: var(--ink); border-color: var(--line-strong); }
+.cmdk-trigger kbd {
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  line-height: 1;
+  padding: 0.28rem 0.36rem;
+  border-radius: var(--radius-sm);
+  background: var(--surface-2);
+  border: 1px solid var(--line);
+  color: var(--muted-soft);
+}
+
+@media (max-width: 1080px) { .cmdk-trigger { display: none; } }
+
+.cmdk-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 200;
+  display: flex;
+  justify-content: center;
+  align-items: flex-start;
+  padding: clamp(1rem, 12vh, 9rem) 1rem 1rem;
+  background: color-mix(in srgb, var(--walnut-950) 62%, transparent);
+  backdrop-filter: blur(6px) saturate(1.1);
+  animation: cmdk-fade 140ms var(--ease-out-quart);
+}
+
+.cmdk-panel {
+  width: min(100%, 620px);
+  max-height: min(70vh, 560px);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border-radius: var(--radius-lg);
+  border: 1px solid var(--line-strong);
+  background: var(--surface-1);
+  box-shadow: var(--shadow-xl);
+  animation: cmdk-rise 180ms var(--ease-out-expo);
+}
+
+.cmdk-search {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0 1.1rem;
+  border-bottom: 1px solid var(--line);
+  color: var(--muted);
+}
+
+.cmdk-search input {
+  flex: 1;
+  border: 0;
+  outline: none;
+  background: none;
+  color: var(--ink);
+  font-family: var(--font-body);
+  font-size: 1rem;
+  padding: 1.05rem 0;
+}
+
+.cmdk-search input::placeholder { color: var(--muted-soft); }
+
+.cmdk-list { overflow-y: auto; padding: 0.5rem; overscroll-behavior: contain; }
+.cmdk-group-label {
+  font-size: 0.68rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--muted-soft);
+  padding: 0.75rem 0.75rem 0.4rem;
+}
+
+.cmdk-item {
+  display: flex;
+  align-items: center;
+  gap: 0.85rem;
+  width: 100%;
+  text-align: left;
+  padding: 0.7rem 0.75rem;
+  border-radius: var(--radius-md);
+  color: var(--ink-soft);
+  font-size: 0.94rem;
+  scroll-margin: 0.5rem;
+}
+
+.cmdk-item[data-active='true'] { background: var(--surface-2); color: var(--ink); }
+.cmdk-item[data-active='true'] .cmdk-item-icon { color: var(--copper); }
+.cmdk-item-icon { display: grid; place-items: center; height: 20px; width: 20px; color: var(--muted); flex: none; }
+.cmdk-item-body { min-width: 0; }
+.cmdk-item-title { display: block; }
+.cmdk-item-hint { display: block; font-size: 0.78rem; color: var(--muted); margin-top: 1px; }
+.cmdk-item-tag {
+  margin-left: auto;
+  flex: none;
+  font-size: 0.66rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--copper);
+  border: 1px solid color-mix(in srgb, var(--copper) 35%, transparent);
+  border-radius: var(--radius-full);
+  padding: 0.2rem 0.5rem;
+}
+
+.cmdk-empty { padding: 2.25rem 1rem; text-align: center; color: var(--muted); font-size: 0.92rem; }
+
+.cmdk-footer {
+  display: flex;
+  gap: 1.1rem;
+  padding: 0.7rem 1.1rem;
+  border-top: 1px solid var(--line);
+  background: var(--surface-2);
+  font-size: 0.72rem;
+  color: var(--muted);
+}
+
+.cmdk-footer kbd {
+  font-family: var(--font-mono);
+  font-size: 0.66rem;
+  background: var(--surface-1);
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  padding: 0.14rem 0.32rem;
+  margin-right: 0.32rem;
+}
+
+@keyframes cmdk-fade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes cmdk-rise { from { opacity: 0; transform: translateY(12px) scale(0.985); } to { opacity: 1; transform: none; } }
+
+@media (prefers-reduced-motion: reduce) {
+  .cmdk-overlay, .cmdk-panel { animation: none; }
+}
+
+/* ------------------------------------------------------------
+   Skip link — first tab stop on the page
+   ------------------------------------------------------------ */
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -100px;
+  z-index: 300;
+  background: var(--copper);
+  color: var(--cream-50);
+  padding: 0.7rem 1.1rem;
+  border-radius: var(--radius-md);
+  font-weight: 600;
+  transition: top 180ms var(--ease-out-quart);
+}
+
+.skip-link:focus-visible { top: 1rem; }
+
+/* ============================================================
+   FLOOR CONFIGURATOR
+   ============================================================ */
+.fc { background: var(--surface-1); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+
+.fc-grid {
+  display: grid;
+  gap: clamp(1.5rem, 3vw, 2.5rem);
+  grid-template-columns: 1fr;
+  align-items: start;
+}
+
+@media (min-width: 900px) {
+  .fc-grid { grid-template-columns: 1.05fr 1fr; grid-template-areas: 'preview controls' 'result result'; }
+  .fc-preview { grid-area: preview; position: sticky; top: calc(var(--header-h) + 1.25rem); }
+  .fc-controls { grid-area: controls; }
+  .fc-result { grid-area: result; }
+}
+
+@media (min-width: 1180px) {
+  .fc-grid { grid-template-columns: 1fr 1fr 0.85fr; grid-template-areas: 'preview controls result'; }
+}
+
+/* ---- Preview ---- */
+.fc-preview {
+  border: 1px solid var(--line);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+  padding: 1rem;
+  box-shadow: var(--shadow-md);
+}
+
+.fc-plank {
+  position: relative;
+  aspect-ratio: 4 / 3;
+  border-radius: var(--radius-md);
+  overflow: hidden;
+  background-color: var(--fc-base);
+  box-shadow: inset 0 0 0 1px var(--line);
+  transition: background-color 420ms var(--ease-out-quart);
+}
+
+.fc-plank::before {
+  /* grain */
+  content: '';
+  position: absolute;
+  inset: -20%;
+  background-image:
+    repeating-linear-gradient(90deg, transparent 0 3px, color-mix(in srgb, var(--fc-grain) 45%, transparent) 3px 4px, transparent 4px 11px),
+    repeating-linear-gradient(90deg, transparent 0 17px, color-mix(in srgb, var(--fc-grain) 22%, transparent) 17px 18px, transparent 18px 41px),
+    repeating-linear-gradient(180deg, color-mix(in srgb, var(--fc-grain) 60%, transparent) 0 2px, transparent 2px 92px);
+  transition: background-image 420ms var(--ease-out-quart);
+}
+
+.fc-plank::after {
+  /* finish tint */
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: var(--fc-tint);
+  transition: background 420ms var(--ease-out-quart);
+}
+
+.fc-plank-sheen {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  background: linear-gradient(115deg, rgba(255, 255, 255, calc(var(--fc-sheen) * 2.4)) 0%, transparent 42%, transparent 70%, rgba(255, 255, 255, var(--fc-sheen)) 100%);
+  transition: background 420ms var(--ease-out-quart);
+}
+
+.fc-plank--diagonal::before { transform: rotate(45deg) scale(1.5); }
+.fc-plank--herringbone::before {
+  background-image:
+    repeating-linear-gradient(45deg, color-mix(in srgb, var(--fc-grain) 70%, transparent) 0 1.5px, transparent 1.5px 34px),
+    repeating-linear-gradient(-45deg, color-mix(in srgb, var(--fc-grain) 70%, transparent) 0 1.5px, transparent 1.5px 34px),
+    repeating-linear-gradient(45deg, transparent 0 4px, color-mix(in srgb, var(--fc-grain) 20%, transparent) 4px 5px, transparent 5px 13px);
+}
+.fc-plank--chevron::before {
+  background-image:
+    repeating-linear-gradient(60deg, color-mix(in srgb, var(--fc-grain) 70%, transparent) 0 1.5px, transparent 1.5px 30px),
+    repeating-linear-gradient(-60deg, color-mix(in srgb, var(--fc-grain) 70%, transparent) 0 1.5px, transparent 1.5px 30px);
+}
+
+.fc-spec {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.85rem 1rem;
+  margin: 1.15rem 0 0;
+}
+.fc-spec div { min-width: 0; }
+.fc-spec dt { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-soft); }
+.fc-spec dd { margin: 0.18rem 0 0; font-weight: 600; color: var(--ink); }
+.fc-note { margin: 1rem 0 0; font-size: 0.86rem; color: var(--muted); line-height: 1.55; }
+
+/* ---- Controls ---- */
+.fc-field { border: 0; margin: 0 0 1.6rem; padding: 0; }
+.fc-field legend {
+  display: flex;
+  align-items: baseline;
+  gap: 0.6rem;
+  width: 100%;
+  padding: 0;
+  margin-bottom: 0.7rem;
+  font-weight: 600;
+  color: var(--ink);
+}
+.fc-step { font-family: var(--font-mono); font-size: 0.7rem; color: var(--copper); }
+.fc-sqft { margin-left: auto; font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); }
+
+.fc-swatches { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 0.6rem; }
+.fc-swatch {
+  display: flex;
+  flex-direction: column;
+  gap: 0.45rem;
+  padding: 0.5rem;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  background: var(--surface);
+  transition: border-color 180ms var(--ease-out-quart), transform 180ms var(--ease-out-quart), box-shadow 180ms var(--ease-out-quart);
+}
+.fc-swatch:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
+.fc-swatch[aria-pressed='true'] { border-color: var(--copper); box-shadow: 0 0 0 1px var(--copper), var(--shadow-warm); }
+.fc-swatch-chip { display: block; height: 42px; border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12); }
+.fc-swatch-name { font-size: 0.78rem; font-weight: 600; color: var(--ink-soft); }
+
+.fc-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
+.fc-pill {
+  padding: 0.55rem 0.95rem;
+  border-radius: var(--radius-full);
+  border: 1px solid var(--line);
+  background: var(--surface);
+  color: var(--muted);
+  font-size: 0.85rem;
+  transition: all 180ms var(--ease-out-quart);
+}
+.fc-pill:hover { color: var(--ink); border-color: var(--line-strong); }
+.fc-pill[aria-pressed='true'] { background: var(--copper); border-color: var(--copper); color: var(--cream-50); }
+
+.fc-range { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 999px; background: var(--surface-2); outline-offset: 6px; }
+.fc-range::-webkit-slider-thumb {
+  -webkit-appearance: none; appearance: none;
+  height: 22px; width: 22px; border-radius: 50%;
+  background: var(--copper); border: 3px solid var(--surface);
+  box-shadow: var(--shadow-md); cursor: grab;
+}
+.fc-range::-moz-range-thumb {
+  height: 22px; width: 22px; border-radius: 50%;
+  background: var(--copper); border: 3px solid var(--surface);
+  box-shadow: var(--shadow-md); cursor: grab;
+}
+.fc-range-ends { display: flex; justify-content: space-between; margin-top: 0.55rem; font-size: 0.72rem; color: var(--muted-soft); }
+
+.fc-postal-label { display: block; font-weight: 600; color: var(--ink); margin-bottom: 0.5rem; }
+.fc-postal-label span { display: block; font-weight: 400; font-size: 0.78rem; color: var(--muted-soft); }
+.fc-postal {
+  width: 100%; max-width: 220px;
+  border: 1px solid var(--line); border-radius: var(--radius-md);
+  background: var(--surface); color: var(--ink);
+  padding: 0.7rem 0.85rem; font-family: var(--font-mono); font-size: 0.9rem;
+  text-transform: uppercase;
+}
+.fc-postal:focus-visible { border-color: var(--copper); }
+
+/* ---- Result ---- */
+.fc-result {
+  border: 1px solid var(--line-strong);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+  padding: clamp(1.25rem, 2.4vw, 1.85rem);
+  box-shadow: var(--shadow-lg);
+}
+.fc-result-label { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-soft); }
+.fc-result-figure {
+  display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;
+  font-family: var(--font-display);
+  font-size: clamp(1.85rem, 3.6vw, 2.5rem);
+  font-weight: 500;
+  color: var(--ink);
+  margin: 0.55rem 0 0.35rem;
+  font-variant-numeric: tabular-nums;
+}
+.fc-result-figure em { color: var(--copper); font-style: normal; }
+.fc-result-sub { font-size: 0.83rem; color: var(--muted); font-family: var(--font-mono); }
+.fc-disclaimer {
+  margin: 1.15rem 0;
+  padding: 0.85rem 1rem;
+  border-left: 2px solid var(--copper);
+  background: var(--surface-2);
+  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
+  font-size: 0.83rem;
+  line-height: 1.6;
+  color: var(--muted);
+}
+.fc-disclaimer strong { color: var(--ink-soft); }
+
+.fc-actions { display: grid; gap: 0.7rem; }
+.fc-cta { width: 100%; justify-content: center; }
+.fc-secondary {
+  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
+  width: 100%; padding: 0.8rem 1rem;
+  border: 1px solid var(--line-strong); border-radius: var(--radius-full);
+  background: transparent; color: var(--ink-soft); font-size: 0.9rem; font-weight: 500;
+  transition: all 180ms var(--ease-out-quart);
+}
+.fc-secondary:hover { border-color: var(--copper); color: var(--copper); }
+.fc-handoff { margin: 0.9rem 0 0; text-align: center; font-size: 0.75rem; color: var(--muted-soft); }
+
+/* ============================================================
+   CONVERSION RAIL — WhatsApp + exit intent
+   ============================================================ */
+.wa-fab {
+  position: fixed;
+  left: 22px;
+  bottom: max(22px, env(safe-area-inset-bottom));
+  z-index: 120;
+  height: 54px; width: 54px;
+  display: grid; place-items: center;
+  border-radius: var(--radius-full);
+  background: #25d366;
+  color: #fff;
+  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);
+  transition: transform 180ms var(--ease-out-quart);
+}
+.wa-fab:hover { transform: scale(1.06); }
+
+.exit-overlay {
+  position: fixed; inset: 0; z-index: 210;
+  display: grid; place-items: center;
+  padding: 1.25rem;
+  background: color-mix(in srgb, var(--walnut-950) 68%, transparent);
+  backdrop-filter: blur(5px);
+  animation: cmdk-fade 160ms var(--ease-out-quart);
+}
+.exit-card {
+  position: relative;
+  width: min(100%, 520px);
+  border-radius: var(--radius-lg);
+  border: 1px solid var(--line);
+  background: var(--surface-1);
+  padding: clamp(1.6rem, 4vw, 2.4rem);
+  box-shadow: var(--shadow-xl);
+  animation: cmdk-rise 220ms var(--ease-out-expo);
+}
+.exit-card h3 { margin: 0.7rem 0 0.6rem; font-size: clamp(1.35rem, 2.6vw, 1.7rem); line-height: 1.25; }
+.exit-card > p { color: var(--muted); font-size: 0.95rem; line-height: 1.65; margin: 0 0 1.5rem; }
+.exit-actions { display: grid; gap: 0.7rem; }
+.exit-close {
+  position: absolute; top: 0.85rem; right: 0.95rem;
+  height: 32px; width: 32px; border-radius: var(--radius-full);
+  color: var(--muted); font-size: 1.25rem; line-height: 1;
+  transition: background 160ms var(--ease-out-quart);
+}
+.exit-close:hover { background: var(--surface-2); color: var(--ink); }
+.exit-foot { margin: 1.35rem 0 0; text-align: center; font-size: 0.8rem; color: var(--muted-soft); }
+.exit-foot a { color: var(--copper); font-weight: 600; }
+
+@media (prefers-reduced-motion: reduce) {
+  .exit-overlay, .exit-card, .fc-plank, .fc-plank::before, .fc-plank::after, .fc-plank-sheen { animation: none; transition: none; }
+}
