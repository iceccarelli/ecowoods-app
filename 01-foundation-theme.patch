+
+
+/* ============================================================
+   NIGHT SHOWROOM — dark theme
+   ------------------------------------------------------------
+   Same copper. Same warmth. Lights down.
+   We flip semantic tokens only; every component in this file
+   already consumes them, so no component rules change.
+   Applied via html[data-theme='dark'], set before paint by the
+   no-flash script in app/layout.tsx.
+   ============================================================ */
+html[data-theme='dark'] {
+  /* Surfaces — warm espresso, never neutral grey, never green */
+  --bg: #12100d;
+  --surface: #1b1712;
+  --surface-1: #1b1712;
+  --surface-2: #241e17;
+  --surface-warm: #1b1712;
+  --surface-deep: #0b0906;
+  --paper: #12100d;
+
+  /* Ink inverts */
+  --ink: #f2e9dc;
+  --ink-soft: #dcd0be;
+  --muted: #a2917f;
+  --muted-soft: #7d6e5f;
+
+  /* Hairlines read as light-on-dark now */
+  --line: rgba(242, 233, 220, 0.12);
+  --line-strong: rgba(242, 233, 220, 0.22);
+
+  /* Copper lifts ~1 step so it keeps 4.5:1 on espresso */
+  --copper: #d98f5c;
+  --copper-bright: #eda877;
+  --copper-deep: #b46e40;
+  --copper-glow: oklch(74% 0.15 48);
+
+  /* Wood palette compresses so light-on-walnut sections stay legible */
+  --walnut-950: #0b0906;
+  --walnut-900: #17120d;
+  --walnut-800: #241c14;
+  --maple-200: #6a5844;
+
+  --forest: #6c8358;
+  --moss: #869a6c;
+
+  /* Shadows go deeper + a copper rim replaces the missing ambient light */
+  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.5);
+  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.55), 0 2px 4px rgba(0, 0, 0, 0.3);
+  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.6), 0 4px 12px rgba(0, 0, 0, 0.35);
+  --shadow-xl: 0 24px 60px rgba(0, 0, 0, 0.68), 0 8px 24px rgba(0, 0, 0, 0.4);
+  --shadow-warm: 0 12px 32px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(217, 143, 92, 0.18);
+
+  /* RenoGuide chat */
+  --rg-cream: #1b1712;
+  --rg-paper: #241e17;
+  --rg-ink: #f2e9dc;
+  --rg-border: rgba(242, 233, 220, 0.14);
+  --rg-muted: #a2917f;
+  --rg-shadow: rgba(0, 0, 0, 0.65);
+  --rg-bubble-shadow: rgba(0, 0, 0, 0.35);
+}
+
+/* Photography carries most of the page's light. At night we pull it back
