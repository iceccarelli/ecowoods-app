+function nearbyAreas(slug: string): City[] {
+  const published = new Set(SERVICE_AREAS.map((a) => a.slug));
+  const out: string[] = [];
+  const push = (s: string | undefined) => {
+    if (s && s !== slug && published.has(s) && !out.includes(s)) out.push(s);
