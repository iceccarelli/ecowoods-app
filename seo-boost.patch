+                <summary style={{ cursor: 'pointer', fontWeight: 600 }}>{f.q}</summary>
+                <p style={{ marginTop: '0.6rem', opacity: 0.85 }}>{f.a}</p>
+              </details>
+            ))}
+          </div>
+        </div>
+      </section>
+
+      <section className="section">
+        <div className="shell">
+          <span className="eyebrow">Also serving</span>
