{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "TURBO_FORCE=true pnpm build && mkdir -p public && cp -R apps/web/public/. public/",
  "outputDirectory": "apps/web/.next",

  "redirects": [
    {"source": "/:path*", "has": [{"type": "host", "value": "www\\.ecowoods\\.ca"}], "destination": "https://ecowoods.ca/:path*", "permanent": true}
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" }
      ]
    },
    {
      "source": "/(login|register|verify-email)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(admin|mypage|docs)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/((?!api/|_next/|admin|mypage|docs/|login|register|verify-email)(?!.*\\.).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/films/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/catalogues/(.*).pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=31536000, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-snippet:-1" }
      ]
    },
    { "source": "/llms.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/llms-full.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/ai.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/api/knowledge", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ],

  "crons": [
    { "path": "/api/cron/quote-recovery", "schedule": "0 * * * *" },
    { "path": "/api/cron/review-requests", "schedule": "30 * * * *" }
  ],

  "cleanUrls": true,
  "trailingSlash": false
}
