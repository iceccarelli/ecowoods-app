{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "TURBO_FORCE=true pnpm build",
  "outputDirectory": "apps/web/.next",

  "redirects": [
    {"source": "/", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}, {"type": "query", "key": "fuseaction", "value": "store\\.(terms|returns|shipping)"}], "destination": "https://ecowoods.ca/", "permanent": true},
    {"source": "/blogs/testimonials", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/reviews", "permanent": true},
    {"source": "/blogs/testimonials/:rest*", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/reviews", "permanent": true},
    {"source": "/blogs/ecowoods-hardwood-flooring-blog", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/blog", "permanent": true},
    {"source": "/blogs/ecowoods-hardwood-flooring-blog/:rest*", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/blog", "permanent": true},
    {"source": "/pages/ecowoods-hardwood-flooring-testimonials-toronto-etobicoke", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/reviews", "permanent": true},
    {"source": "/pages/ecowoods-hardwood-flooring-contractors-toronto-etobicoke-hamilton", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/about", "permanent": true},
    {"source": "/pages/flooring-services-toronto-etobicoke-hamilton", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/services", "permanent": true},
    {"source": "/pages/hardwood-floor-installation-and-refinishing-toronto-etobicoke-hamilton", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/#quote", "permanent": true},
    {"source": "/pages/home", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/", "permanent": true},
    {"source": "/privacy-policy", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/privacy", "permanent": true},
    {"source": "/", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "(www\\.)?ecowoodshardwood\\.com"}], "destination": "https://ecowoods.ca/", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "www\\.ecowoods\\.ca"}], "destination": "https://ecowoods.ca/:path*", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "ecowoods-app\\.vercel\\.app"}], "destination": "https://ecowoods.ca/:path*", "permanent": true}
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" }
      ]
    },
    {
      "source": "/(login|register|verify-email)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(admin|mypage|docs)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    { "source": "/llms.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/llms-full.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/ai.txt", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/api/knowledge", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ],

  "cleanUrls": true,
  "trailingSlash": false
}
