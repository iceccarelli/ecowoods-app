+  display: flex; align-items: center; gap: 1rem; min-height: 38px;
+}
+.ub-grow { flex: 1 1 auto; }
+.ub-sep { width: 1px; height: 12px; background: currentColor; opacity: 0.3; }
+.ub-item { white-space: nowrap; }
+.ub-link { color: var(--on-dark-muted); text-decoration: none; }
+.ub-link:hover, .ub-link:focus-visible { color: var(--copper-bright); text-decoration: underline; }
+.ub-phone {
