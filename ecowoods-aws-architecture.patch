+}
+.ub-phone:hover, .ub-phone:focus-visible { color: var(--copper-bright); }
+@media (max-width: 720px) {
+  /* On a phone the strip keeps the two facts that convert and drops the rest.
+     Everything hidden here is still in the footer and still in the mega-menu. */
+  .ub-area, .ub-sep, .ub-hide-sm { display: none; }
+  .ub-inner { gap: 0.75rem; font-size: 0.72rem; }
+}
+
+/* ── the mega-menu ──────────────────────────────────────────────────────── */
+.mm { position: relative; display: inline-flex; }
+.mm-trigger {
+  display: inline-flex; align-items: center; gap: 0.3rem;
