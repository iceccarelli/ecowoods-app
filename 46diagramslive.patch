+  }
+  const fmt = b.toString('ascii', 12, 16);
+  if (fmt === 'VP8X') {
+    return [b.readUIntLE(24, 3) + 1, b.readUIntLE(27, 3) + 1];
+  }
+  if (fmt === 'VP8L') {
+    const n = b.readUInt32LE(21);
+    return [(n & 0x3fff) + 1, ((n >> 14) & 0x3fff) + 1];
+  }
+  if (fmt === 'VP8 ') {
+    return [b.readUInt16LE(26) & 0x3fff, b.readUInt16LE(28) & 0x3fff];
+  }
+  return null;
