// ============================================================
// ECOWOODS — Prisma Schema
// Database: PostgreSQL (Supabase or Neon recommended)
// ORM: Prisma 5.x
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["ecowoods"]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN

  @@schema("ecowoods")
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED

  @@schema("ecowoods")
}

enum ProjectStatus {
  DRAFT
  CONTRACT_SENT
  SIGNED
  DEPOSIT_PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("ecowoods")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID

  @@schema("ecowoods")
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
  PLAID
  CASH

  @@schema("ecowoods")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("ecowoods")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("ecowoods")
}

enum InvoiceStage {
  DEPOSIT
  MIDPOINT
  FINAL
  CUSTOM

  @@schema("ecowoods")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("ecowoods")
}

enum ProductCategory {
  MATERIAL
  ACCESSORY

  @@schema("ecowoods")
}

enum ProductUnit {
  SQFT
  EACH

  @@schema("ecowoods")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  quoteRequests QuoteRequest[]
  projects      Project[]
  inquiries     Inquiry[]
  payments      Payment[]
  accounts      Account[]
  sessions      Session[]
  orders        Order[]

  @@index([email])
  @@schema("ecowoods")
}

model EmailVerificationToken {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  name         String?
  phone        String?
  passwordHash String?
  token        String   @unique @default(uuid())
  expiresAt    DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([token])
  @@index([email])
  @@schema("ecowoods")
}

// next-auth adapter models
model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("ecowoods")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("ecowoods")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// PILOT LEAD — FloorForge & other pilot programs
// ─────────────────────────────────────────────

model PilotLead {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  company   String?
  role      String   // contractor, flooring-specialist, general-builder, property-manager, other
  program   String   // floorforge-waitlist, etc.
  squareFeet Int?
  message   String?  @db.Text
  source    String?  // floorforge-waitlist, web_modal, etc.

  status    String   @default("new")    // new, contacted, qualified, enrolled
  adminNotes String? @db.Text
  contactedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([program])
  @@index([status])
  @@index([createdAt])
  @@schema("ecowoods")
}

/// QuoteRecovery — a consented reminder for a form somebody started and left.
///
/// WHY A TABLE AND NOT A COOKIE
///
/// Someone types an email into the estimate form, gets interrupted, and never
/// submits. Today that person is simply gone: nothing is written until the
/// whole form validates. This is the single largest recoverable loss in the
/// funnel, and it is recovered with ONE email, two hours later, only when the
/// visitor ticked a box asking for it.
///
/// CONSENT IS A COLUMN, NOT A SETTING. `consentedAt` records the moment the box
/// was ticked, and the cron route refuses to send without it. Under CASL an
/// unsolicited commercial email to a Canadian address is an offence with real
/// penalties; a checkbox nobody ticked is not consent, and a column that can be
/// audited is the difference between a recovery programme and a spam programme.
///
/// `sentAt` is what makes it exactly one email. `convertedAt` is set when the
/// same address completes a real lead, so somebody who finished the job never
/// gets asked to finish it again.
///
/// NOTE: comments here are `///` or `//` only. Prisma's schema language has no
/// JSDoc-style block comment; one fails `prisma generate` with P1012 on every
/// line of it, which is exactly how this model first shipped broken.
model QuoteRecovery {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  name      String?
  phone     String?
  source    String?  // which page the form was on
  service   String?
  city      String?

  /// When the visitor ticked the reminder box. No consent, no send. Ever.
  consentedAt DateTime @db.Timestamptz
  /// Set once, when the single reminder goes out.
  sentAt      DateTime? @db.Timestamptz
  /// Set when this address submitted a real lead — cancels the reminder.
  convertedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([sentAt])
  @@index([createdAt])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// QUOTE REQUEST
// ─────────────────────────────────────────────

model QuoteRequest {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  city        String?
  province    String?
  address     String?
  species     Json?       @db.JsonB
  squareFeet  Int?
  projectType String?
  timeline    String?
  budgetRange String?
  service     String?
  notes       String?     @db.Text
  attachments Json?       @db.JsonB
  status      QuoteStatus @default(PENDING)

  /// MEAS-01 — the design this request came from, if it came from one.
  ///
  /// Minted in the browser by lib/floor-studio/design-id.ts, 12 Crockford
  /// base32 characters, validated before it is written. It names a DESIGN, not
  /// a person: a share link passed to a spouse carries the same id, which is
  /// the point. Nullable because a request can arrive from a phone call, a
  /// service page or the chat assistant, and a lead without a design is a
  /// perfectly good lead — it is simply not attributable to the studio.
  designId    String?     @db.VarChar(16)
  adminNotes  String?     @db.Text

  stripeCheckoutSessionId String?

  quotedAmount    Decimal?  @db.Decimal(12, 2)
  quoteTaxRate    Decimal?  @db.Decimal(5, 2)
  quoteLineItems  Json      @default("[]") @db.JsonB
  quoteNotes      String?   @db.Text
  quoteValidUntil DateTime? @db.Timestamptz
  quoteIssuedAt   DateTime? @db.Timestamptz
  quotePdfUrl     String?

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId String?  @unique @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  appointments Appointment[]

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([designId])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// PROJECT / CONTRACT
// ─────────────────────────────────────────────

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id])
  quoteRequest QuoteRequest?

  title       String
  description String?   @db.Text
  address     String?
  city        String?
  province    String?
  species     Json?     @db.JsonB
  squareFeet  Int?
  startDate   DateTime? @db.Timestamptz
  endDate     DateTime? @db.Timestamptz

  status               ProjectStatus @default(DRAFT)
  contractPdfUrl       String?
  signedContractPdfUrl String?
  contractSignedAt     DateTime?     @db.Timestamptz

  depositPct    Decimal? @default(30.00) @db.Decimal(5, 2)
  midpointPct   Decimal? @default(40.00) @db.Decimal(5, 2)
  finalPct      Decimal? @default(30.00) @db.Decimal(5, 2)
  taxRate       Decimal? @default(13.00) @db.Decimal(5, 2)
  contractValue Decimal? @db.Decimal(12, 2)

  /// Stamped once, before the post-job review request is sent. One request per
  /// project, identical for every customer — see lib/review-request.ts.
  reviewRequestedAt DateTime? @db.Timestamptz

  /// MEAS-01 — copied forward from the QuoteRequest this project was converted
  /// from, so revenue joins to the design without a three-table hop.
  ///
  /// Denormalised on purpose. The alternative is joining Payment → Invoice →
  /// Project → QuoteRequest on every attribution question, and the question
  /// "of the last 100 deposits, how many began in Floor Studio" is one this
  /// business needs to be able to ask cheaply and often. It is copied once at
  /// conversion and never updated, because the design that produced a job does
  /// not change after the job exists.
  designId          String?   @db.VarChar(16)

  invoices Invoice[]
  notes    ProjectNote[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@index([reviewRequestedAt])
  @@index([designId])
  @@schema("ecowoods")
}

model ProjectNote {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────

model Invoice {
  id        String  @id @default(uuid()) @db.Uuid
  number    String? @unique
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])

  stage  InvoiceStage?
  status InvoiceStatus @default(DRAFT)

  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  surchargePct Decimal @default(0) @db.Decimal(5, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)

  lineItems   Json      @default("[]") @db.JsonB
  description String?   @db.Text
  dueDate     DateTime? @db.Timestamptz
  issuedAt    DateTime? @db.Timestamptz
  paidAt      DateTime? @db.Timestamptz
  pdfUrl      String?

  stripePaymentIntentId String?

  payments Payment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([projectId])
  @@index([status])
  @@index([number])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod?
  status PaymentStatus @default(PENDING)

  stripePaymentIntentId String?
  stripeCharged         Boolean @default(false)

  bankReference       String?
  bankConfirmedAt     DateTime? @db.Timestamptz
  bankConfirmedByNote String?

  plaidTransactionId String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([invoiceId])
  @@index([status])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// INQUIRY
// ─────────────────────────────────────────────

model Inquiry {
  id      String        @id @default(uuid()) @db.Uuid
  userId  String?       @db.Uuid
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name    String
  email   String
  phone   String?
  subject String?
  message String        @db.Text
  status  InquiryStatus @default(NEW)

  replies InquiryReply[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([status])
  @@index([userId])
  @@schema("ecowoods")
}

model InquiryReply {
  id        String   @id @default(uuid()) @db.Uuid
  inquiryId String   @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// GLOBAL SETTINGS (single row)
// ─────────────────────────────────────────────

model Settings {
  id String @id @default(uuid()) @db.Uuid

  defaultDepositPct  Decimal @default(30) @db.Decimal(5, 2)
  defaultMidpointPct Decimal @default(40) @db.Decimal(5, 2)
  defaultFinalPct    Decimal @default(30) @db.Decimal(5, 2)
  defaultTaxRate     Decimal @default(13) @db.Decimal(5, 2)

  companyName      String?
  companyAddress   String?
  companyPhone     String?
  companyEmail     String?
  companyNumberHst String?
  companyLogoUrl   String?

  aiEnabled Boolean @default(true)

  aiBankTransferInstructions String? @db.Text

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────────

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  quoteRequestId String       @db.Uuid
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  startsAt        DateTime          @db.Timestamptz
  durationMinutes Int               @default(60)
  status          AppointmentStatus @default(SCHEDULED)

  customerName  String?
  customerEmail String?
  customerPhone String?
  notes         String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([startsAt])
  @@index([status])
  @@index([quoteRequestId])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// SHOP — PRODUCTS / ORDERS
// ─────────────────────────────────────────────

model Product {
  id       String          @id @default(uuid()) @db.Uuid
  slug     String          @unique
  name     String
  category ProductCategory
  unit     ProductUnit

  basePrice   Decimal @db.Decimal(10, 2)
  minQuantity Decimal @default(1) @db.Decimal(10, 2)

  species     String?
  format      String?
  janka       Int?
  imageUrl       String?
  imageCredit    String?
  imageCreditUrl String?
  description String? @db.Text

  // [{ name: string, choices: [{ label: string, priceDelta: number }] }]
  options Json @default("[]") @db.JsonB

  active Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([category])
  @@index([active])
  @@schema("ecowoods")
}

model Order {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @db.Uuid
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(12, 2)
  taxRate  Decimal @default(13) @db.Decimal(5, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String? @db.Text

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime? @db.Timestamptz

  items OrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@schema("ecowoods")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  unit        ProductUnit
  quantity    Decimal     @db.Decimal(10, 2)
  unitPrice   Decimal     @db.Decimal(10, 2)

  // [{ name: string, choice: string, priceDelta: number }]
  selectedOptions Json @default("[]") @db.JsonB

  lineTotal Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// FLOOR GRAPH
// ─────────────────────────────────────────────
//
// WHY THIS SECTION EXISTS
//
// Everything above this line records a COMMERCIAL transaction: someone asked
// for a price, a price was written, a contract was signed, an invoice was
// paid. None of it records what was actually true about the floor. Species,
// substrate, moisture at the time of installation, how many hours the crew
// spent, which grit sequence was run, what the finish did eighteen months
// later — the entire physical record of the work is, today, in an estimator's
// head and in a folder of photographs attached to internal email.
//
// That is the asset. The React app, the FastAPI service, the schema above and
// every AI model that will ever be pointed at this business can be rebuilt by
// a competent team in a quarter. A structured record of two thousand Toronto
// floors — what was there, what was done, what it cost, and what happened
// afterwards — cannot be rebuilt at all without doing the work.
//
// THE TEST EVERY COLUMN HERE HAD TO PASS
//
// Not "could we collect this". Two questions, in order:
//   1. What prediction does this field make measurably better?
//   2. What decision does that prediction change?
// A field that cannot answer both is not in this schema. That is why there is
// no `customerMood`, no `crewNotes` free-text blob and no `photoTags` — they
// are collectable and they are inert.
//
// THREE STRUCTURAL DECISIONS, EACH DELIBERATE
//
// 1. NO HARD FOREIGN KEY TO QuoteRequest OR Project. The links are UUID
//    columns with indexes and no `@relation`. A Prisma relation would give us
//    referential integrity and, with it, a cascade: erasing a lead under a
//    PIPEDA access-and-correction request would silently delete the outcome
//    record for a floor that still exists in a house. The commercial record
//    and the physical record have different lifetimes and different lawful
//    bases, and the schema has to say so. Joins are done in application code,
//    which is where the consent check belongs anyway.
//
// 2. CONSENT IS A ROW, NOT A BOOLEAN. `ConsentRecord` is append-only and
//    scoped to a purpose. Retention of a photograph and use of that photograph
//    to train a model are two different purposes requiring two different
//    grants — the federal, provincial and territorial privacy regulators said
//    so jointly in December 2023, and PIPEDA case summary #2006-349 already
//    held that photographs of a dwelling's interior are personal information
//    about the person who lives there. A `consented: true` column cannot
//    record which purpose, when, on what wording, or that it was withdrawn.
//
// 3. THE BENCHMARK TABLE HOLDS NO IDENTIFIERS AT ALL. `FrameworkScoring` has
//    no name, no email, no IP, no user id and no free text — twenty-seven
//    characters, a version string and a coarse region. It is the one dataset
//    here that is meant to become public, and the only safe way to publish a
//    dataset is to build it so that there is nothing in it to leak.

/// What a person has agreed to, separately. Never collapse these.
enum ConsentPurpose {
  /// Keep the photographs past the triage that prompted them.
  ASSESSMENT_PHOTOS
  /// Use this assessment's photographs and readings to improve prediction.
  MODEL_TRAINING
  /// Add an anonymous framework scoring to the published benchmark.
  BENCHMARK_CONTRIBUTION
  /// Keep a durable record of this floor and hand it to a future owner.
  FLOOR_RECORD

  @@schema("ecowoods")
}

enum ConsentState {
  GRANTED
  WITHDRAWN

  @@schema("ecowoods")
}

/// Where a Floor Graph row came from. Provenance is not optional metadata:
/// a moisture reading taken by a senior estimator with a pin meter and one
/// inferred from a photograph are not the same fact and must never be pooled.
enum FloorGraphSource {
  PHOTO_TRIAGE
  MEASURE_VISIT
  JOB_EXECUTION
  FRAMEWORK_ASSESS
  IMPORT

  @@schema("ecowoods")
}

enum AssessmentStatus {
  UNREVIEWED
  TRIAGED
  MEASURED
  CLOSED

  @@schema("ecowoods")
}

/// What was predicted. One row per prediction, closed against one actual.
enum PredictionKind {
  PRICE_CAD
  LABOUR_HOURS
  MATERIAL_SQFT
  SCHEDULE_DAYS

  @@schema("ecowoods")
}

/// Append-only consent ledger. A withdrawal is a new row, never an update:
/// "we had consent on 3 March and it was withdrawn on 9 April" is a different
/// and more defensible statement than "consent is currently false".
model ConsentRecord {
  id      String         @id @default(uuid()) @db.Uuid
  purpose ConsentPurpose
  state   ConsentState   @default(GRANTED)

  /// The subject, as we can identify them at the moment of collection. Email
  /// is the only handle a triage submission has; it is lowercased by the
  /// caller so a withdrawal matches every grant.
  subjectEmail String?
  /// Set once the subject has an account.
  userId       String? @db.Uuid

  /// The exact wording shown, stored verbatim. A consent you cannot reproduce
  /// is a consent you cannot defend.
  wording   String  @db.Text
  /// Where it was granted, e.g. "estimate-form:photos" or "framework-assess".
  surface   String
  /// Version of the wording, so a change of copy is visible in the ledger.
  version   String  @default("1")

  grantedAt   DateTime  @default(now()) @db.Timestamptz
  withdrawnAt DateTime? @db.Timestamptz

  @@index([subjectEmail, purpose])
  @@index([userId, purpose])
  @@index([grantedAt])
  @@schema("ecowoods")
}

/// The passport spine. One row per physical floor, not per customer and not
/// per job — a floor outlives both, which is the entire point.
model FloorRecord {
  id String @id @default(uuid()) @db.Uuid

  /// Human-facing stable handle, e.g. "FR-2026-0001". Printed on the record.
  publicRef String @unique

  /// Coarse location only. Full address lives on the commercial record; a
  /// floor's postal district is enough to model climate and enough to be
  /// useful in aggregate, and it is all we are willing to keep on a row
  /// designed to outlive the customer relationship.
  city            String?
  province        String?
  postalPrefix    String?
  propertyType    String?
  /// Storey the floor is on. Basement slab and third-floor joists behave
  /// differently under the same humidity; without it, moisture data is noise.
  storey          String?

  areaSqFt     Int?
  species      String?
  boardWidthMm Decimal? @db.Decimal(6, 2)
  boardThickMm Decimal? @db.Decimal(6, 2)
  pattern      String?
  finishSystem String?
  substrate    String?
  installMethod String?
  installedOn  DateTime? @db.Date

  /// Soft link. See the header: no cascade from the commercial record.
  originQuoteRequestId String? @db.Uuid
  originProjectId      String? @db.Uuid

  assessments FloorAssessment[]
  outcomes    JobOutcome[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  /// Set when the subject asks for erasure. The row is retained with the
  /// identifying columns nulled, because the physical facts about a floor are
  /// not personal information once they cannot be tied to a person.
  erasedAt  DateTime? @db.Timestamptz

  @@index([city])
  @@index([species])
  @@index([installedOn])
  @@index([originProjectId])
  @@schema("ecowoods")
}

/// One look at one floor at one moment. A triage from three photographs and a
/// senior estimator's measured visit are both assessments; `source` and
/// `confidence` are what keep them from being averaged together.
model FloorAssessment {
  id String @id @default(uuid()) @db.Uuid

  floorRecordId String?      @db.Uuid
  floorRecord   FloorRecord? @relation(fields: [floorRecordId], references: [id], onDelete: SetNull)

  source FloorGraphSource
  status AssessmentStatus @default(UNREVIEWED)

  /// Soft links to the commercial record.
  quoteRequestId String? @db.Uuid
  projectId      String? @db.Uuid

  /// What the submitter said, in the vocabulary the form already collects.
  statedIntent String?
  statedSqFt   Int?
  city         String?

  /// What was OBSERVED. Every one of these is nullable and stays null until
  /// somebody actually measured it — an inferred value written into the same
  /// column as a measured one destroys the dataset it was meant to enrich.
  observedSpecies      String?
  observedFinish       String?
  observedSubstrate    String?
  observedDamage       Json?    @db.JsonB
  moisturePctWood      Decimal? @db.Decimal(5, 2)
  moisturePctSubfloor  Decimal? @db.Decimal(5, 2)
  relativeHumidityPct  Decimal? @db.Decimal(5, 2)
  temperatureC         Decimal? @db.Decimal(5, 2)
  /// How the readings above were taken, e.g. "pin meter, Delmhorst BD-2100".
  instrument           String?

  /// The recommendation actually given, and by whom. `reviewedBy` empty means
  /// no human has looked at this yet, and nothing downstream may present it
  /// as a diagnosis.
  recommendation String?
  reviewedBy     String?
  reviewedAt     DateTime? @db.Timestamptz

  photos AssessmentPhoto[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  erasedAt  DateTime? @db.Timestamptz

  @@index([floorRecordId])
  @@index([quoteRequestId])
  @@index([source, status])
  @@index([createdAt])
  @@schema("ecowoods")
}

/// A photograph kept because the person who sent it said we could keep it.
/// No consent row for ASSESSMENT_PHOTOS, no row here — the capture path
/// refuses to write one, and scripts/verify-floor-graph.mjs checks that it
/// still refuses.
model AssessmentPhoto {
  id           String          @id @default(uuid()) @db.Uuid
  assessmentId String          @db.Uuid
  assessment   FloorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Storage URL. Blob in production, Supabase or local in development —
  /// same ladder as lib/pdf/storage.ts.
  url         String
  contentType String
  bytes       Int
  /// Ordinal within the submission, so "the second photo" is stable.
  position    Int    @default(0)

  /// The consent row this photograph is retained under. Not a boolean, and
  /// not nullable: a photograph with no consent id has no lawful basis.
  consentId String        @db.Uuid

  /// Structured observations, written only by a human or by a reviewed model
  /// run. Never overwritten in place — a new run appends a new key.
  observations Json? @db.JsonB

  createdAt DateTime  @default(now()) @db.Timestamptz
  erasedAt  DateTime? @db.Timestamptz

  @@index([assessmentId])
  @@index([consentId])
  @@schema("ecowoods")
}

/// An anonymous scoring of somebody's quote against the Well-Installed
/// Framework, contributed on purpose.
///
/// THIS TABLE HAS NO IDENTIFIERS AND IS NEVER TO GAIN ANY. Not an email, not a
/// user id, not an IP, not a free-text field, not a timestamp finer than the
/// day. It exists so the business can eventually publish a sentence no
/// competitor can publish — "of 1,240 GTA hardwood quotes scored against v1.0,
/// 61% did not answer criterion 1.3" — and that sentence is only worth
/// publishing if the dataset behind it could be released whole tomorrow.
model FrameworkScoring {
  id String @id @default(uuid()) @db.Uuid

  /// Framework version the answers were given against. An answer set scored
  /// against v1.0 is not comparable to one scored against v1.1.
  frameworkVersion String
  /// One character per criterion, in PILLARS order: y | u | n | -.
  answers          String
  /// Derived at write time so the benchmark can be queried without decoding.
  score            Int
  verdict          String
  criticalFailures Int      @default(0)

  /// Coarse geography only. A GTA municipality, or null.
  region String?
  /// Day precision. An exact timestamp on a low-volume table is a fingerprint.
  scoredOn DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([frameworkVersion, scoredOn])
  @@index([region])
  @@schema("ecowoods")
}

/// What actually happened, recorded once the job is done. This is the half of
/// the Floor Graph that no competitor can copy off a public repository,
/// because it does not exist until somebody sands a floor.
model JobOutcome {
  id String @id @default(uuid()) @db.Uuid

  floorRecordId String?      @db.Uuid
  floorRecord   FloorRecord? @relation(fields: [floorRecordId], references: [id], onDelete: SetNull)

  /// Soft link to the commercial record.
  projectId String? @db.Uuid

  service       String?
  completedOn   DateTime? @db.Date

  /// Execution.
  labourHours   Decimal? @db.Decimal(8, 2)
  machineHours  Decimal? @db.Decimal(8, 2)
  crewSize      Int?
  gritSequence  String?
  finishCoats   Int?
  cureHours     Decimal? @db.Decimal(6, 2)

  /// Materials, in the unit the trade actually orders in.
  materialSqFt   Decimal? @db.Decimal(10, 2)
  wastePct       Decimal? @db.Decimal(5, 2)
  finishLitres   Decimal? @db.Decimal(8, 2)

  /// Economics. Kept because margin variance is the signal that decides which
  /// jobs to bid for, and it is meaningless without both sides.
  materialCostCad Decimal? @db.Decimal(12, 2)
  labourCostCad   Decimal? @db.Decimal(12, 2)
  sellingPriceCad Decimal? @db.Decimal(12, 2)

  /// Consequences.
  scheduleDays   Int?
  defects        Json?     @db.JsonB
  callbackAt     DateTime? @db.Timestamptz
  warrantyClaimAt DateTime? @db.Timestamptz

  notes String? @db.Text

  predictions Prediction[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([floorRecordId])
  @@index([projectId])
  @@index([completedOn])
  @@schema("ecowoods")
}

/// The prediction ledger.
///
/// A model that is never scored against reality is a rumour with a confidence
/// interval. Every number this business commits to — the quoted price, the
/// hours the schedule assumed, the material ordered — is written here when it
/// is made, with the inputs that produced it, and closed later against what
/// actually happened. `error` and `absPctError` are computed on close, so the
/// question "is our estimating getting better or worse this quarter" is a
/// single aggregate query and not a research project.
model Prediction {
  id String @id @default(uuid()) @db.Uuid

  kind   PredictionKind
  /// What produced it: "published-band", "estimator", "configurator", or a
  /// model identifier once one exists. Never blank — an unattributed
  /// prediction cannot be improved.
  model  String
  /// Free-form but structured: the inputs available at prediction time. This
  /// is the training set's feature vector, captured before the outcome is
  /// known, which is the only time it can be captured honestly.
  inputs Json @db.JsonB

  predictedValue Decimal  @db.Decimal(14, 4)
  predictedLow   Decimal? @db.Decimal(14, 4)
  predictedHigh  Decimal? @db.Decimal(14, 4)
  predictedAt    DateTime @default(now()) @db.Timestamptz

  /// Soft links to whatever the prediction was about.
  quoteRequestId String? @db.Uuid
  projectId      String? @db.Uuid

  jobOutcomeId String?     @db.Uuid
  jobOutcome   JobOutcome? @relation(fields: [jobOutcomeId], references: [id], onDelete: SetNull)

  actualValue Decimal?  @db.Decimal(14, 4)
  closedAt    DateTime? @db.Timestamptz
  /// actual − predicted. Signed on purpose: a business that is 8% under on
  /// every job has a different problem from one that is ±8% at random.
  error       Decimal?  @db.Decimal(14, 4)
  absPctError Decimal?  @db.Decimal(8, 4)

  @@index([kind, predictedAt])
  @@index([quoteRequestId])
  @@index([projectId])
  @@index([closedAt])
  @@schema("ecowoods")
}

/// ─────────────────────────────────────────────────────────────────────────
/// MEAS-02 — the funnel ledger.
///
/// WHY A TABLE RATHER THAN MORE GA4
///
/// PG0 found nine of the brief's twenty-one canonical events missing, and the
/// last five of them — appointment, estimate, acceptance, deposit,
/// job_complete — are structurally unreachable from the existing instrument:
/// every one is a SERVER write (Appointment, QuoteRequest.quoteIssuedAt,
/// Project.status, Invoice, JobOutcome) and lib/analytics.ts `track()` returns
/// early when `window` is undefined. No amount of client work reaches them.
///
/// The obvious fix is GA4's Measurement Protocol. It was rejected, and the
/// reason is worth writing down rather than rediscovering:
///
///   1. Measurement Protocol requires a `client_id`, which identifies a
///      DEVICE. Nothing on the server has one. Synthesising it from the design
///      id would file every deposit under a fabricated user, inflating GA4's
///      user counts with people who do not exist. A number that is wrong in a
///      flattering direction is the worst kind.
///   2. These are commercial facts about transactions — a deposit cleared, a
///      job finished — not observations of a person's behaviour. They belong
///      in the business's own records, not in a third party's.
///   3. GA4 cannot answer the success question anyway. "Of the last 100
///      deposits, how many began in Floor Studio, and what was the margin on
///      those versus the rest" needs revenue and cost, and those live here.
///
/// So GA4 keeps the top of the funnel, where consent and device identity are
/// real and correct, and this table takes the commercial end. One join key —
/// `designId` from MEAS-01 — spans both.
///
/// WHAT IT MUST NEVER HOLD
///
/// No name, no email, no phone, no address, no IP. Not a shadow CRM: the
/// customer record already exists on QuoteRequest and User, and duplicating it
/// is exactly what the brief's Rule #5 forbids. This table holds a stage, a
/// timestamp, an amount, and foreign keys as bare indexed UUIDs. Everything
/// needed to count money; nothing that identifies a person.

enum FunnelStage {
  LEAD_CAPTURED
  APPOINTMENT_BOOKED
  QUOTE_ISSUED
  QUOTE_ACCEPTED
  DEPOSIT_PAID
  JOB_COMPLETED

  @@schema("ecowoods")
}

model FunnelEvent {
  id    String      @id @default(uuid()) @db.Uuid
  stage FunnelStage

  /// MEAS-01's join key. Null is the honest value for a lead that arrived by
  /// phone, from a service page, or through the assistant — those are real
  /// leads that simply did not begin in a design, and recording them as
  /// unattributed is the difference between a denominator and a guess.
  designId String? @db.VarChar(16)

  /// Which surface the journey started on, as the lead reported it — the same
  /// `source` the estimate form posts. Free-form because it is a label, not a
  /// controlled vocabulary, and a wrong enum is harder to fix than a wrong
  /// string.
  source String? @db.VarChar(120)

  /// Bare UUIDs with indexes, no foreign keys — the same choice the Floor
  /// Graph made and for the same reason: erasing a commercial record must
  /// never cascade into the ledger that says how the business performed.
  quoteId   String? @db.Uuid
  projectId String? @db.Uuid

  /// The money at this stage, where there is any: the quoted total at
  /// QUOTE_ISSUED, the deposit at DEPOSIT_PAID, the contract value at
  /// JOB_COMPLETED. Always the figure in the currency the job was written in.
  amountCad Decimal? @db.Decimal(12, 2)

  occurredAt DateTime @default(now()) @db.Timestamptz

  @@index([stage, occurredAt])
  @@index([designId])
  @@index([projectId])
  @@index([quoteId])
  @@schema("ecowoods")
}
