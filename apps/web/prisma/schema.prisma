// ============================================================
// ECOWOODS — Prisma Schema
// Database: PostgreSQL (Supabase or Neon recommended)
// ORM: Prisma 5.x
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["ecowoods"]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN

  @@schema("ecowoods")
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED

  @@schema("ecowoods")
}

enum ProjectStatus {
  DRAFT
  CONTRACT_SENT
  SIGNED
  DEPOSIT_PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("ecowoods")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID

  @@schema("ecowoods")
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
  PLAID
  CASH

  @@schema("ecowoods")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("ecowoods")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("ecowoods")
}

enum InvoiceStage {
  DEPOSIT
  MIDPOINT
  FINAL
  CUSTOM

  @@schema("ecowoods")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("ecowoods")
}

enum ProductCategory {
  MATERIAL
  ACCESSORY

  @@schema("ecowoods")
}

enum ProductUnit {
  SQFT
  EACH

  @@schema("ecowoods")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  quoteRequests QuoteRequest[]
  projects      Project[]
  inquiries     Inquiry[]
  payments      Payment[]
  accounts      Account[]
  sessions      Session[]
  orders        Order[]

  @@index([email])
  @@schema("ecowoods")
}

model EmailVerificationToken {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  name         String?
  phone        String?
  passwordHash String?
  token        String   @unique @default(uuid())
  expiresAt    DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([token])
  @@index([email])
  @@schema("ecowoods")
}

// next-auth adapter models
model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("ecowoods")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("ecowoods")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// PILOT LEAD — FloorForge & other pilot programs
// ─────────────────────────────────────────────

model PilotLead {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  company   String?
  role      String   // contractor, flooring-specialist, general-builder, property-manager, other
  program   String   // floorforge-waitlist, etc.
  squareFeet Int?
  message   String?  @db.Text
  source    String?  // floorforge-waitlist, web_modal, etc.

  status    String   @default("new")    // new, contacted, qualified, enrolled
  adminNotes String? @db.Text
  contactedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([program])
  @@index([status])
  @@index([createdAt])
  @@schema("ecowoods")
}

/// QuoteRecovery — a consented reminder for a form somebody started and left.
///
/// WHY A TABLE AND NOT A COOKIE
///
/// Someone types an email into the estimate form, gets interrupted, and never
/// submits. Today that person is simply gone: nothing is written until the
/// whole form validates. This is the single largest recoverable loss in the
/// funnel, and it is recovered with ONE email, two hours later, only when the
/// visitor ticked a box asking for it.
///
/// CONSENT IS A COLUMN, NOT A SETTING. `consentedAt` records the moment the box
/// was ticked, and the cron route refuses to send without it. Under CASL an
/// unsolicited commercial email to a Canadian address is an offence with real
/// penalties; a checkbox nobody ticked is not consent, and a column that can be
/// audited is the difference between a recovery programme and a spam programme.
///
/// `sentAt` is what makes it exactly one email. `convertedAt` is set when the
/// same address completes a real lead, so somebody who finished the job never
/// gets asked to finish it again.
///
/// NOTE: comments here are `///` or `//` only. Prisma's schema language has no
/// JSDoc-style block comment; one fails `prisma generate` with P1012 on every
/// line of it, which is exactly how this model first shipped broken.
model QuoteRecovery {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  name      String?
  phone     String?
  source    String?  // which page the form was on
  service   String?
  city      String?

  /// When the visitor ticked the reminder box. No consent, no send. Ever.
  consentedAt DateTime @db.Timestamptz
  /// Set once, when the single reminder goes out.
  sentAt      DateTime? @db.Timestamptz
  /// Set when this address submitted a real lead — cancels the reminder.
  convertedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([sentAt])
  @@index([createdAt])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// QUOTE REQUEST
// ─────────────────────────────────────────────

model QuoteRequest {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  city        String?
  province    String?
  address     String?
  species     Json?       @db.JsonB
  squareFeet  Int?
  projectType String?
  timeline    String?
  budgetRange String?
  service     String?
  notes       String?     @db.Text
  attachments Json?       @db.JsonB
  status      QuoteStatus @default(PENDING)
  adminNotes  String?     @db.Text

  stripeCheckoutSessionId String?

  quotedAmount    Decimal?  @db.Decimal(12, 2)
  quoteTaxRate    Decimal?  @db.Decimal(5, 2)
  quoteLineItems  Json      @default("[]") @db.JsonB
  quoteNotes      String?   @db.Text
  quoteValidUntil DateTime? @db.Timestamptz
  quoteIssuedAt   DateTime? @db.Timestamptz
  quotePdfUrl     String?

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId String?  @unique @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  appointments Appointment[]

  @@index([email])
  @@index([status])
  @@index([userId])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// PROJECT / CONTRACT
// ─────────────────────────────────────────────

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id])
  quoteRequest QuoteRequest?

  title       String
  description String?   @db.Text
  address     String?
  city        String?
  province    String?
  species     Json?     @db.JsonB
  squareFeet  Int?
  startDate   DateTime? @db.Timestamptz
  endDate     DateTime? @db.Timestamptz

  status               ProjectStatus @default(DRAFT)
  contractPdfUrl       String?
  signedContractPdfUrl String?
  contractSignedAt     DateTime?     @db.Timestamptz

  depositPct    Decimal? @default(30.00) @db.Decimal(5, 2)
  midpointPct   Decimal? @default(40.00) @db.Decimal(5, 2)
  finalPct      Decimal? @default(30.00) @db.Decimal(5, 2)
  taxRate       Decimal? @default(13.00) @db.Decimal(5, 2)
  contractValue Decimal? @db.Decimal(12, 2)

  /// Stamped once, before the post-job review request is sent. One request per
  /// project, identical for every customer — see lib/review-request.ts.
  reviewRequestedAt DateTime? @db.Timestamptz

  invoices Invoice[]
  notes    ProjectNote[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@index([reviewRequestedAt])
  @@schema("ecowoods")
}

model ProjectNote {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────

model Invoice {
  id        String  @id @default(uuid()) @db.Uuid
  number    String? @unique
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])

  stage  InvoiceStage?
  status InvoiceStatus @default(DRAFT)

  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  surchargePct Decimal @default(0) @db.Decimal(5, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)

  lineItems   Json      @default("[]") @db.JsonB
  description String?   @db.Text
  dueDate     DateTime? @db.Timestamptz
  issuedAt    DateTime? @db.Timestamptz
  paidAt      DateTime? @db.Timestamptz
  pdfUrl      String?

  stripePaymentIntentId String?

  payments Payment[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([projectId])
  @@index([status])
  @@index([number])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod?
  status PaymentStatus @default(PENDING)

  stripePaymentIntentId String?
  stripeCharged         Boolean @default(false)

  bankReference       String?
  bankConfirmedAt     DateTime? @db.Timestamptz
  bankConfirmedByNote String?

  plaidTransactionId String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([invoiceId])
  @@index([status])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// INQUIRY
// ─────────────────────────────────────────────

model Inquiry {
  id      String        @id @default(uuid()) @db.Uuid
  userId  String?       @db.Uuid
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name    String
  email   String
  phone   String?
  subject String?
  message String        @db.Text
  status  InquiryStatus @default(NEW)

  replies InquiryReply[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([email])
  @@index([status])
  @@index([userId])
  @@schema("ecowoods")
}

model InquiryReply {
  id        String   @id @default(uuid()) @db.Uuid
  inquiryId String   @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// GLOBAL SETTINGS (single row)
// ─────────────────────────────────────────────

model Settings {
  id String @id @default(uuid()) @db.Uuid

  defaultDepositPct  Decimal @default(30) @db.Decimal(5, 2)
  defaultMidpointPct Decimal @default(40) @db.Decimal(5, 2)
  defaultFinalPct    Decimal @default(30) @db.Decimal(5, 2)
  defaultTaxRate     Decimal @default(13) @db.Decimal(5, 2)

  companyName      String?
  companyAddress   String?
  companyPhone     String?
  companyEmail     String?
  companyNumberHst String?
  companyLogoUrl   String?

  aiEnabled Boolean @default(true)

  aiBankTransferInstructions String? @db.Text

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────────

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  quoteRequestId String       @db.Uuid
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  startsAt        DateTime          @db.Timestamptz
  durationMinutes Int               @default(60)
  status          AppointmentStatus @default(SCHEDULED)

  customerName  String?
  customerEmail String?
  customerPhone String?
  notes         String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([startsAt])
  @@index([status])
  @@index([quoteRequestId])
  @@schema("ecowoods")
}

// ─────────────────────────────────────────────
// SHOP — PRODUCTS / ORDERS
// ─────────────────────────────────────────────

model Product {
  id       String          @id @default(uuid()) @db.Uuid
  slug     String          @unique
  name     String
  category ProductCategory
  unit     ProductUnit

  basePrice   Decimal @db.Decimal(10, 2)
  minQuantity Decimal @default(1) @db.Decimal(10, 2)

  species     String?
  format      String?
  janka       Int?
  imageUrl       String?
  imageCredit    String?
  imageCreditUrl String?
  description String? @db.Text

  // [{ name: string, choices: [{ label: string, priceDelta: number }] }]
  options Json @default("[]") @db.JsonB

  active Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([category])
  @@index([active])
  @@schema("ecowoods")
}

model Order {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @db.Uuid
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)

  subtotal Decimal @db.Decimal(12, 2)
  taxRate  Decimal @default(13) @db.Decimal(5, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String? @db.Text

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime? @db.Timestamptz

  items OrderItem[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@schema("ecowoods")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  unit        ProductUnit
  quantity    Decimal     @db.Decimal(10, 2)
  unitPrice   Decimal     @db.Decimal(10, 2)

  // [{ name: string, choice: string, priceDelta: number }]
  selectedOptions Json @default("[]") @db.JsonB

  lineTotal Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@schema("ecowoods")
}
