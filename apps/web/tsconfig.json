{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@ecowoods/shared": ["../../packages/shared/src"],
      "@ecowoods/shared/*": ["../../packages/shared/src/*"],
      "@ecowoods/api-client": ["../../packages/api-client/src"],
      "@ecowoods/api-client/*": ["../../packages/api-client/src/*"],
      "@ecowoods/ui": ["../../packages/ui/src"],
      "@ecowoods/ui/*": ["../../packages/ui/src/*"],
      "@ecowoods/auth": ["../../packages/auth/src"],
      "@ecowoods/auth/*": ["../../packages/auth/src/*"],
      "@ecowoods/types": ["../../packages/types/src"],
      "@ecowoods/types/*": ["../../packages/types/src/*"],
      "@ecowoods/config": ["../../packages/config/src"],
      "@ecowoods/config/*": ["../../packages/config/src/*"],
      "@ecowoods/utils": ["../../packages/utils/src"],
      "@ecowoods/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
