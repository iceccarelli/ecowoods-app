---
 .dockerignore                     | 36 +++++++++++++++++++++++++++++++
 package.json                      |  1 +
 services/render-api/.dockerignore |  8 -------
 services/render-api/README.md     | 17 +++++++++++++++
 services/render-api/fly.toml      |  7 ++++++
 5 files changed, 61 insertions(+), 8 deletions(-)
 create mode 100644 .dockerignore
 delete mode 100644 services/render-api/.dockerignore

diff --git a/.dockerignore b/.dockerignore
new file mode 100644
index 0000000..266f509
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,36 @@
+# Docker reads .dockerignore FROM THE BUILD CONTEXT ROOT, and both images in
+# this repository are built with the repository root as their context:
+#
+#     fly deploy --dockerfile services/render-api/Dockerfile     (render API)
+#     docker compose up --build                                  (backend/Dockerfile, context: .)
+#
+# This file used to live at services/render-api/.dockerignore, next to the
+# Dockerfile it was written for, which reads as the obvious place and is a
+# place Docker never looks. It was silently dead: every build would have sent
+# node_modules, .next, .turbo, .git, the whole photograph gallery and the audit
+# corpus into the daemon and then into the image. Nothing failed, because
+# nothing about a fat image fails — it is just slow and large, which is exactly
+# the kind of defect that survives until someone measures an image.
+#
+# Keep it here. A copy next to a Dockerfile is decoration.
+
+**/node_modules
+**/.next
+**/.turbo
+.git
+
+# Build-time copies, not sources. vercel.json's buildCommand mirrors
+# apps/web/public into the repo-root public/ so Vercel serves it as the static
+# root (see docs/PUBLIC_ASSETS.md). After any local build that is a second copy
+# of every asset in the repository, and neither image serves static files.
+/public
+/.vercel
+
+# Photographs the API does not read. The render service samples its own PNG
+# tiles under services/render-api/textures; the gallery and the illustrations
+# are for the website and are the largest thing in the tree.
+apps/web/public/gallery
+apps/web/public/illustrations
+
+docs
+audit
diff --git a/package.json b/package.json
index d20487d..4227cde 100644
--- a/package.json
+++ b/package.json
@@ -73,6 +73,7 @@
     "verify:allocation": "node scripts/verify-allocation.mjs",
     "verify:geo:green": "node scripts/verify-geo-green.mjs",
     "test:web": "pnpm --filter @ecowoods/web test",
+    "test:render-api": "node --experimental-strip-types ./services/render-api/src/keys.test.ts && node --experimental-strip-types --import ./services/render-api/src/register.mjs ./services/render-api/src/plate.test.ts",
     "seo:audit": "node scripts/audit-current-state.mjs",
     "seo:pricing": "node scripts/verify-pricing-source.mjs",
     "seo:claims": "node scripts/verify-claims.mjs",
diff --git a/services/render-api/.dockerignore b/services/render-api/.dockerignore
deleted file mode 100644
index 29fd0fc..0000000
--- a/services/render-api/.dockerignore
+++ /dev/null
@@ -1,8 +0,0 @@
-**/node_modules
-**/.next
-**/.turbo
-.git
-apps/web/public/gallery
-apps/web/public/illustrations
-docs
-audit
diff --git a/services/render-api/README.md b/services/render-api/README.md
index edff13d..68069d6 100644
--- a/services/render-api/README.md
+++ b/services/render-api/README.md
@@ -32,6 +32,23 @@ shared-cpu-2x the table above says roughly 190 renders a minute at 1280×960
 before the queue builds, which is the rung to leave it on until p95 says
 otherwise.
 
+## Running its tests
+
+```bash
+pnpm test:render-api          # from the repository root
+```
+
+NOT `pnpm --filter @ecowoods/render-api test`, which answers "No projects
+matched the filters" — `services/*` is not in `pnpm-workspace.yaml`, so this
+package is not a workspace member and pnpm cannot see it.
+
+That is deliberate, and it is the same decision as the section below. Adding
+`services/*` to the workspace adds an importer entry to `pnpm-lock.yaml`, and
+this repository installs with `--frozen-lockfile`: a lockfile that does not
+match the workspace fails the install for everyone, everywhere, including every
+other agent working in this tree. A package with no dependencies gains nothing
+from being an importer. It gains a script at the root, which is what it has.
+
 ## Zero dependencies, deliberately
 
 `package.json` has no dependencies and there is no build step. The repository
diff --git a/services/render-api/fly.toml b/services/render-api/fly.toml
index 1841191..5216850 100644
--- a/services/render-api/fly.toml
+++ b/services/render-api/fly.toml
@@ -11,7 +11,14 @@ primary_region = "yyz"
 
 [env]
   PORT = "8080"
+  # The ceiling on a photograph a caller uploads to /v1/render.
   MAX_PIXELS = "4000000"
+  # And on a plate /v1/plate will draw. Separate because they are separate
+  # costs: an uploaded photograph is decoded once, a plate is rendered pixel by
+  # pixel, and 2.4M of the second is about a second and a half of CPU. It was
+  # only a default in the code; a limit that exists in one place is a limit
+  # nobody can see when they go looking for what this machine will do.
+  MAX_PLATE_PIXELS = "2400000"
 
 [http_service]
   internal_port = 8080
