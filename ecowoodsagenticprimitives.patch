+    for (const rule of rules) {
+      const allow = Array.isArray(rule.allow) ? rule.allow : [rule.allow];
+      for (const p of ['/llms.txt', '/llms-full.txt', '/md/', '/api/v1/', '/api/knowledge']) expect(allow, JSON.stringify(rule.userAgent)).toContain(p);
+    }
