+
+  return (
+    <section className="fs" id="studio" aria-labelledby="fs-studio-heading">
+      <div className="shell">
+        <h2 id="fs-studio-heading" className="fs-h">
+          {stage === 'studio' ? 'Your floor, in your room' : 'See your new floor in your home'}
+        </h2>
+
+        {error && (
+          <p className="fs-error" role="alert">
+            {error}
+          </p>
+        )}
+
+        {/* ── START ──────────────────────────────────────────────────────── */}
+        {stage === 'start' && (
+          <div className="fs-start">
+            <p className="fs-lede">
+              Upload a photo, use your camera, or start with a floor. Everything happens on your own
+              device — the photo never leaves it, and we do not keep it.
+            </p>
+            <div className="fs-start-actions">
+              <label className="btn btn-copper btn-lg fs-file">
+                Upload a room photo
