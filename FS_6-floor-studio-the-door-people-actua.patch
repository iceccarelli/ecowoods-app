+
+/**
+ * /floor-studio — ECOWOODS FLOOR STUDIO.
+ *
+ * ONE SYSTEM, FOUR DOORS, AND THIS IS THE ONE PEOPLE COME THROUGH
+ *
+ *   /floor-studio  discovery: a photograph, a real floor rendered into it, desire
+ *   /design        the advanced configurator, already live and untouched
+ *   /estimate      the professional measure and the fixed written price
+ *   /pricing       the published bands
+ *
+ * The studio does not duplicate /design and does not replace it. /design asks a
+ * person who already knows they want hardwood to specify it; the studio asks a
+ * person who does not yet know what they want to SEE it. They share one
+ * catalogue, one pricing function and one handoff, so a visitor moving between
+ * them never feels they left the company.
+ *
+ * WHY THE INTERACTIVE PART IS AN ISLAND IN A SERVER PAGE
+ *
+ * The wow is a canvas and the canvas needs the browser. Everything around it —
+ * what the studio is, which floors exist, what the bands are, what it refuses
+ * to do — is server-rendered prose, because a page whose entire content appears
+ * only after hydration is a page a crawler, a retrieval system and a person on
+ * a bad connection all see as empty. This site has already paid for that lesson
+ * once (F-160: <form> count zero on every page).
+ *
+ * THE COPY BELOW IS NOT FILLER. It is the machine-readable statement of what
+ * Floor Studio is, which is the only way an assistant answering "can I see a
+ * floor in my own room before I buy it in Toronto" can know this exists.
+ */
+
+const url = `${SITE_URL}/floor-studio`;
+
+export const metadata: Metadata = {
+  title: 'Floor Studio — see your new floor in your room',
+  description:
+    `Upload a photo of your room and see real ${BUSINESS_NAP.name} floors in it — species, finish, pattern and board width, with a live estimated installed range in CAD. The photo never leaves your device.`,
+  alternates: { canonical: '/floor-studio', types: { 'text/markdown': '/floor-studio.md' } },
+  openGraph: {
+    title: 'Ecowoods Floor Studio — see your new floor in your room',
+    description:
+      'A photo of your room, a real Ecowoods floor rendered into it, and a live installed range. A range, not a quote.',
+    type: 'website',
+    url,
+  },
+};
+
+const STEPS = [
+  {
+    id: 'step-photo',
+    title: 'Your photo, read in your browser',
+    body:
+      'The studio measures the light in the room, the undertone of the walls, how dark the floor that is there now reads, and where the floor plane appears to meet them. All of it runs on your own device. Nothing is uploaded and we keep nothing.',
+  },
+  {
+    id: 'step-correct',
+    title: 'You correct what we got wrong',
+    body:
+      'Four corners you can drag or move with the arrow keys. We never claim the boundary is certain, and we ask for the two things a photograph genuinely cannot tell us: how many square feet you are covering, and which room this is.',
+  },
+  {
+    id: 'step-see',
+    title: 'Real floors, in your room',
+    body:
+      'Every floor you can see is one we can supply and install. Nothing is generated by an image model, because a floor that does not exist cannot be bought. Change species, finish, pattern or board width and the room changes with it.',
+  },
+  {
+    id: 'step-price',
+    title: 'A range, then a fixed price',
