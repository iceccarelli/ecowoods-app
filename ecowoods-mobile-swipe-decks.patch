 }
+
+/* ============================================================
+   SWIPE DECK — PANEL CARD VARIANTS (pillars + testimonials)
+   Shares the .pfd engine/classes with the portfolio deck; only the card
+   surface + inner content differ. Panels are solid dark cards (draggable
+   cards must be opaque to stack cleanly) matching the site's dark sections.
+   ============================================================ */
+.pfd-card--panel {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 0.9rem;
+  padding: 2rem 1.9rem;
+  text-align: left;
+  background:
+    radial-gradient(120% 90% at 15% 0%, rgba(200, 126, 79, 0.14), transparent 55%),
+    linear-gradient(160deg, var(--walnut-900) 0%, var(--walnut-950) 100%);
+  border: 1px solid rgba(245, 239, 230, 0.1);
+}
+
+/* --- pillar (The Ecowoods Standard) --- */
+.pfd-panel-icon {
+  width: 64px;
+  height: 64px;
+  border-radius: 16px;
+  display: grid;
+  place-items: center;
+  color: var(--copper-bright);
+  background: rgba(200, 126, 79, 0.12);
+  border: 1px solid rgba(200, 126, 79, 0.28);
+  margin-bottom: 0.4rem;
+}
+.pfd-panel-icon svg {
+  width: 30px;
+  height: 30px;
+}
+.pfd-panel-title {
+  margin: 0;
+  font-family: var(--font-display);
+  color: var(--cream-50);
+  font-size: 1.55rem;
+  line-height: 1.12;
+  letter-spacing: -0.01em;
+}
+.pfd-panel-body {
+  margin: 0;
+  color: rgba(245, 239, 230, 0.78);
+  font-size: 1rem;
+  line-height: 1.55;
+}
+
+/* --- review (Proof / testimonials) --- */
+.pfd-card--review {
+  justify-content: space-between;
+}
+.pfd-review-stars {
+  display: flex;
+  gap: 0.3rem;
+  color: var(--copper-bright);
+}
+.pfd-review-stars svg {
+  width: 22px;
+  height: 22px;
+}
+.pfd-quote {
+  margin: 0;
+  flex: 1;
+  display: flex;
+  align-items: center;
+  font-family: var(--font-display);
+  font-style: italic;
+  color: var(--cream-50);
+  font-size: 1.28rem;
+  line-height: 1.42;
+  letter-spacing: -0.005em;
+}
+.pfd-author {
+  display: flex;
+  align-items: center;
+  gap: 0.85rem;
+}
+.pfd-avatar {
+  flex: 0 0 auto;
+  width: 48px;
+  height: 48px;
+  border-radius: 999px;
+  display: grid;
+  place-items: center;
+  font-weight: 700;
+  font-size: 0.95rem;
+  color: var(--cream-50);
+  background: linear-gradient(135deg, var(--copper), var(--copper-bright));
+}
+.pfd-author-meta {
+  display: flex;
+  flex-direction: column;
+  gap: 0.15rem;
+}
+.pfd-author-name {
+  color: var(--cream-50);
+  font-weight: 600;
+  font-size: 1rem;
+}
+.pfd-author-place {
+  color: rgba(245, 239, 230, 0.6);
+  font-size: 0.85rem;
+}
+
+/* Panels look best a touch shorter than the image deck on tall content. */
+.pfd-card--review .pfd-quote {
+  font-size: clamp(1.05rem, 4.4vw, 1.32rem);
+}
