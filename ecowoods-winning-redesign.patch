--- a/apps/web/app/globals.css
+++ b/apps/web/app/globals.css
@@ -3259,3 +3259,276 @@ p {
 @media (max-width: 600px) {
   .estimate-modal { padding: 1.5rem 1.25rem; max-height: 94vh; }
 }
+
+/* ============================================================
+   MARKET-LEADER REDESIGN — new landing sections
+   ============================================================ */
+
+/* Warranty callout (Proof & Authority) */
+.warranty-callout {
+  margin-top: 3rem;
+  display: flex;
+  align-items: flex-start;
+  gap: 1.5rem;
+  padding: 2rem 2.25rem;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-left: 3px solid var(--copper-deep);
+  border-radius: var(--radius-xl);
+  box-shadow: var(--shadow-md);
+}
+.warranty-callout-icon {
+  flex-shrink: 0;
+  width: 56px;
+  height: 56px;
+  border-radius: 14px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--copper-deep);
+  background: rgba(176, 109, 58, 0.1);
+}
+.warranty-callout h3 {
+  margin-bottom: 0.4rem;
+  font-size: 1.25rem;
+}
+.warranty-callout p {
+  color: var(--muted);
+  max-width: 68ch;
+}
+
+/* The Ecowoods Standard — 4 pillars */
+.standard-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 1.25rem;
+  margin-top: 3rem;
+}
+.standard-pillar {
+  padding: 2rem 1.75rem;
+  border-radius: var(--radius-xl);
+  background: rgba(245, 239, 230, 0.04);
+  border: 1px solid rgba(245, 239, 230, 0.1);
+  transition: transform 250ms var(--ease-out-quart), border-color 250ms ease;
+}
+.standard-pillar:hover {
+  transform: translateY(-4px);
+  border-color: rgba(245, 239, 230, 0.25);
+}
+.standard-pillar-icon {
+  width: 48px;
+  height: 48px;
+  margin-bottom: 1.25rem;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 12px;
+  color: var(--copper-bright);
+  background: rgba(245, 239, 230, 0.06);
+  border: 1px solid rgba(245, 239, 230, 0.12);
+}
+.standard-pillar h4 {
+  color: var(--cream-50);
+  font-size: 1.05rem;
+  margin-bottom: 0.6rem;
+  line-height: 1.3;
+}
+.standard-pillar p {
+  color: rgba(245, 239, 230, 0.72);
+  font-size: 0.92rem;
+  line-height: 1.55;
+}
+@media (max-width: 1024px) {
+  .standard-grid { grid-template-columns: repeat(2, 1fr); }
+}
+@media (max-width: 560px) {
+  .standard-grid { grid-template-columns: 1fr; }
+}
+
+/* Services chip row */
+.service-chip-row {
+  margin-top: 2.5rem;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.6rem;
+}
+.service-chip {
+  padding: 0.5rem 1rem;
+  border-radius: var(--radius-full);
+  font-size: 0.85rem;
+  font-weight: 500;
+  color: rgba(245, 239, 230, 0.85);
+  background: rgba(245, 239, 230, 0.05);
+  border: 1px solid rgba(245, 239, 230, 0.14);
+}
+
+/* How It Works — 4-step funnel */
+.funnel-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-xl);
+  overflow: hidden;
+  box-shadow: var(--shadow-md);
+}
+.funnel-step {
+  padding: 2.25rem 1.75rem;
+  border-right: 1px solid var(--line);
+}
+.funnel-step:last-child { border-right: none; }
+.funnel-step-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 1.25rem;
+}
+.funnel-step-icon {
+  width: 44px;
+  height: 44px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 12px;
+  color: var(--copper-deep);
+  background: rgba(176, 109, 58, 0.1);
+}
+.funnel-step-icon svg { width: 24px; height: 24px; }
+.funnel-step-num {
+  font-family: var(--font-display);
+  font-size: 1.8rem;
+  font-weight: 300;
+  color: var(--line);
+}
+.funnel-step h4 {
+  font-size: 1.02rem;
+  margin-bottom: 0.5rem;
+  line-height: 1.3;
+}
+.funnel-step p {
+  color: var(--muted);
+  font-size: 0.9rem;
+  line-height: 1.55;
+}
+@media (max-width: 1024px) {
+  .funnel-grid { grid-template-columns: repeat(2, 1fr); }
+  .funnel-step:nth-child(2) { border-right: none; }
+  .funnel-step:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
+}
+@media (max-width: 560px) {
+  .funnel-grid { grid-template-columns: 1fr; }
+  .funnel-step { border-right: none; border-bottom: 1px solid var(--line); }
+  .funnel-step:last-child { border-bottom: none; }
+}
+
+/* Species — collapsed accordion */
+.species-accordion {
+  border: 1px solid var(--line);
+  border-radius: var(--radius-xl);
+  background: var(--surface);
+  overflow: hidden;
+}
+.species-accordion summary {
+  list-style: none;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 1.5rem 2rem;
+}
+.species-accordion summary::-webkit-details-marker { display: none; }
+.species-accordion-hint {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  font-size: 0.88rem;
+  color: var(--muted);
+}
+.species-accordion-body {
+  padding: 0 2rem 2rem;
+  border-top: 1px solid var(--line);
+}
+.species-row {
+  display: grid;
+  grid-template-columns: 160px 220px 1fr;
+  gap: 1rem;
+  padding: 0.9rem 0;
+  border-bottom: 1px solid var(--line);
+  font-size: 0.92rem;
+  align-items: baseline;
+}
+.species-row:last-of-type { border-bottom: none; }
+.species-row span { color: var(--muted); }
+.species-row em { color: var(--ink-soft); font-style: italic; }
+.species-accordion-note {
+  margin-top: 1.25rem;
+  font-size: 0.88rem;
+  color: var(--muted);
+}
+@media (max-width: 720px) {
+  .species-row { grid-template-columns: 1fr; gap: 0.15rem; }
+}
+
+/* Coverage — slim chip strip */
+.areas-slim {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  padding: 1.75rem 2rem;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-xl);
+  background: var(--surface);
+}
+.areas-slim-label {
+  font-size: 0.9rem;
+  font-weight: 600;
+  color: var(--ink-soft);
+}
+.areas-slim-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+.area-chip-slim {
+  padding: 0.35rem 0.85rem;
+  border-radius: var(--radius-full);
+  font-size: 0.82rem;
+  color: var(--muted);
+  border: 1px solid var(--line);
+  background: transparent;
+}
+
+/* ============================================================
+   HEADER REFINEMENT — AWS-grade trust polish
+   (visual layer only; zero JSX/functionality changes)
+   ============================================================ */
+:root { --header-h: 72px; }
+
+.topbar {
+  background: rgba(253, 251, 246, 0.85);
+  backdrop-filter: saturate(180%) blur(16px);
+  -webkit-backdrop-filter: saturate(180%) blur(16px);
+}
+.topbar.scrolled {
+  background: rgba(253, 251, 246, 0.98);
+  box-shadow: 0 1px 0 var(--line), 0 8px 24px rgba(26, 15, 8, 0.06);
+}
+.topbar-inner {
+  padding-top: 0.7rem;
+  padding-bottom: 0.7rem;
+}
+.topbar-nav a {
+  font-size: 0.875rem;
+  letter-spacing: 0.005em;
+  border-radius: var(--radius-md, 8px);
+}
+.topbar-nav a.active {
+  background: rgba(176, 109, 58, 0.08);
+}
+.brand-mark {
+  width: 40px;
+  height: 40px;
+  border-radius: 10px;
+}
+.brand-copy strong { font-size: 1.12rem; }
