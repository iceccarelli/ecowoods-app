+        '@id': `${url}#stops`,
+        name: `Municipalities on the ${corridor.name} route, in travel order`,
+        itemListOrder: 'https://schema.org/ItemListOrderAscending',
+        numberOfItems: stops.length,
+        itemListElement: stops.map((stop, i) => {
