 .cmdk-overlay {
   position: fixed;
@@ -4139,3 +4154,164 @@ html[data-theme='dark'] .paper-texture {
   white-space: nowrap;
   border: 0;
 }
+
+
+/* ============================================================
+   HEADER — progressive disclosure ladder
+   ------------------------------------------------------------
+   The bar carries brand + 6 nav links + search + theme + login +
+   phone + CTA. That needs ~1340px. It only collapsed at 768px, so
+   everything between 769px and ~1340px overflowed off the right edge
+   (the "Free Quote" button was the casualty). Adding the theme toggle
+   and the ⌘K trigger cost another ~150px and made it obvious.
+
+   Each step below sheds the least valuable pixels first, in order:
+     kbd hint → search label → phone number → login → nav
+   The phone number and login never actually disappear: both stay in
+   the mobile sheet, and ⌘K still has "Call (416) 249-1276".
+   ============================================================ */
+
+/* 1. The ⌘K hint is decoration long before the button is. */
+@media (max-width: 1400px) {
+  .cmdk-trigger kbd { display: none; }
+}
+
+/* 2. Search collapses to its icon. */
+@media (max-width: 1300px) {
+  .cmdk-trigger-label { display: none; }
+  .cmdk-trigger { width: 38px; padding: 0; justify-content: center; }
+}
+
+/* 3. The phone becomes an icon — still a one-tap tel: link. */
+@media (max-width: 1180px) {
+  .phone-pill-label { display: none; }
+  .phone-pill {
+    width: 38px; padding: 0; justify-content: center;
+    border-color: var(--line);
+  }
+}
+
+/* 4. Login moves into the sheet. */
+@media (max-width: 1060px) {
+  .login-btn { display: none; }
+}
+
+/* 5. Nav becomes the hamburger — and the freed space earns the labels back. */
+@media (max-width: 1000px) {
+  .topbar-nav { display: none; }
+  .hamburger { display: inline-flex; }
+  .cmdk-trigger-label { display: inline; }
+  .cmdk-trigger { width: auto; padding: 0 0.7rem 0 0.75rem; }
+}
+
+/* 6. Phone-as-icon is enough on a phone; the sheet has the rest. */
+@media (max-width: 768px) {
+  .cmdk-trigger { display: none; }
+}
+
+@media (max-width: 400px) {
+  .brand-copy small { display: none; }
+}
+
+/* ============================================================
+   READING PROGRESS — scroll position + section rail
+   ============================================================ */
+.progress-rail {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 3px;
+  z-index: 90; /* above .topbar (80) so it survives the hide-on-scroll header */
+  pointer-events: none;
+  opacity: 0;
+  transition: opacity 260ms var(--ease-out-quart);
+}
+
+.progress-rail[data-visible='true'] { opacity: 1; }
+
+.progress-rail-track {
+  position: absolute;
+  inset: 0;
+  background: color-mix(in srgb, var(--ink) 8%, transparent);
+}
+
+.progress-rail-fill {
+  position: absolute;
+  inset: 0;
+  transform-origin: 0 50%;
+  transform: scaleX(0);
+  background: linear-gradient(90deg, var(--copper-deep), var(--copper), var(--copper-bright));
+  will-change: transform;
+}
+
+/* Ticks sit ON the rail. Copper once passed, hairline before. */
+.progress-rail-ticks {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+
+.progress-tick {
+  position: absolute;
+  top: 50%;
+  width: 7px;
+  height: 7px;
+  margin-left: -3.5px;
+  border-radius: 50%;
+  transform: translateY(-50%);
+  background: var(--surface-2);
+  border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
+  pointer-events: auto;
+  transition: background 200ms var(--ease-out-quart), transform 200ms var(--ease-out-quart),
+    border-color 200ms var(--ease-out-quart);
+}
+
+.progress-tick[data-passed='true'] {
+  background: var(--copper);
+  border-color: var(--copper-deep);
+}
+
+.progress-tick:hover,
+.progress-tick:focus-visible {
+  transform: translateY(-50%) scale(1.55);
+}
+
+.progress-tick-label {
+  position: absolute;
+  top: 14px;
+  left: 50%;
+  transform: translateX(-50%) translateY(-4px);
+  padding: 0.32rem 0.6rem;
+  border-radius: var(--radius-full);
+  background: var(--surface);
+  border: 1px solid var(--line);
+  box-shadow: var(--shadow-md);
+  color: var(--ink-soft);
+  font-size: 0.7rem;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  white-space: nowrap;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity 160ms var(--ease-out-quart), transform 160ms var(--ease-out-quart);
+}
+
+.progress-tick:hover .progress-tick-label,
+.progress-tick:focus-visible .progress-tick-label {
+  opacity: 1;
+  transform: translateX(-50%) translateY(0);
+}
+
+/* Ticks need room to breathe and a hover surface. Bar only on small screens. */
+@media (max-width: 900px) {
+  .progress-rail-ticks { display: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .progress-rail, .progress-rail-fill, .progress-tick, .progress-tick-label { transition: none; }
+}
+
+@media print {
+  .progress-rail { display: none; }
+}
