From bdb986694fed1babf26c88c406b6366b27ccba27 Mon Sep 17 00:00:00 2001
From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Sun, 19 Jul 2026 12:21:06 +0000
Subject: [PATCH 07/11] fix(web): base .hero uses 100svh (vh fallback) to stop
 mobile viewport overflow
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The base .hero was min-height:100vh. On mobile, 100vh is the LARGE viewport
(ignores the address bar), so the hero was taller than the visible screen and
its content could sit behind browser chrome. Switched to progressive
enhancement: 100vh fallback first, then 100svh so modern browsers fill exactly
the small viewport with no overflow. Note: the 88vh/88svh overrides at <=480px
are left intact pending a visual check — flagged, not changed.
---
 apps/web/app/globals.css | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/apps/web/app/globals.css b/apps/web/app/globals.css
index 90f9121..25e0c1b 100644
--- a/apps/web/app/globals.css
+++ b/apps/web/app/globals.css
@@ -884,7 +884,8 @@ p {
 /* --------------------- Hero --------------------- */
 .hero {
   position: relative;
-  min-height: 100vh;
+  min-height: 100vh; /* fallback for browsers without svh */
+  min-height: 100svh; /* small viewport height: fills exactly, no address-bar overflow */
   display: flex;
   align-items: center;
   padding-top: 6rem;
-- 
2.43.0


From 3841172b474cfb46d83cbd9abc6dc5479eaed9ad Mon Sep 17 00:00:00 2001
From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Sun, 19 Jul 2026 12:22:45 +0000
Subject: [PATCH 08/11] fix(lint): register @typescript-eslint plugin; re-arm
 no-img-element
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

next lint reported 9 errors: eslint-disable directives for
@typescript-eslint/no-explicit-any and no-var-requires referenced rules that
were never registered (plugin installed but not loaded), so ESLint failed on
the orphaned directives. Registered the plugin and set those two rules to off,
so the directives resolve without flooding the codebase with new any-errors.
Also dropped the '@next/next/no-img-element: off' override — now that all raw
<img> are next/image, the rule guards against regressions. Result: next lint
passes with zero warnings or errors.
---
 .eslintrc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/.eslintrc b/.eslintrc
index 2bad790..25c5ab1 100644
--- a/.eslintrc
+++ b/.eslintrc
@@ -1,6 +1,8 @@
 {
   "extends": ["next/core-web-vitals"],
+  "plugins": ["@typescript-eslint"],
   "rules": {
-    "@next/next/no-img-element": "off"
+    "@typescript-eslint/no-explicit-any": "off",
+    "@typescript-eslint/no-var-requires": "off"
   }
 }
-- 
2.43.0


From bb5c27cd8aee01746fc3e8542440055ccf6c543b Mon Sep 17 00:00:00 2001
From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Sun, 19 Jul 2026 12:24:24 +0000
Subject: [PATCH 09/11] a11y(web): announce quote-form validation errors to
 screen readers

The quote form validated (zod) and showed error text visually, but the inputs
had no aria-invalid and the messages no role=alert, so assistive tech never
announced a failed field. Added aria-invalid to name/phone/email/postal inputs
and role=alert to each error message. Supports the Accessibility target.
---
 apps/web/app/page.tsx | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/apps/web/app/page.tsx b/apps/web/app/page.tsx
index bb21f6a..54c4ba5 100644
--- a/apps/web/app/page.tsx
+++ b/apps/web/app/page.tsx
@@ -714,19 +714,21 @@ const onSubmit = (data: LeadFormData) => {
                       id="f-name"
                       {...register('name')}
                       placeholder="Jane Doe"
+                      aria-invalid={!!errors.name}
                       className={errors.name ? 'field-error' : ''}
                     />
-                    {errors.name && <p className="error-message">{errors.name.message}</p>}
+                    {errors.name && <p className="error-message" role="alert">{errors.name.message}</p>}
                   </div>
                   <div className="field">
                     <label htmlFor="f-phone">Phone *</label>
                     <input
                       id="f-phone"
                       {...register('phone')}
+                      aria-invalid={!!errors.phone}
                       placeholder="(416) 249-1276"
                       className={errors.phone ? 'field-error' : ''}
                     />
-                    {errors.phone && <p className="error-message">{errors.phone.message}</p>}
+                    {errors.phone && <p className="error-message" role="alert">{errors.phone.message}</p>}
                   </div>
                 </div>
 
@@ -737,21 +739,23 @@ const onSubmit = (data: LeadFormData) => {
                       id="f-email"
                       type="email"
                       {...register('email')}
+                      aria-invalid={!!errors.email}
                       placeholder="jane@example.com"
                       className={errors.email ? 'field-error' : ''}
                     />
-                    {errors.email && <p className="error-message">{errors.email.message}</p>}
+                    {errors.email && <p className="error-message" role="alert">{errors.email.message}</p>}
                   </div>
                   <div className="field">
                     <label htmlFor="f-postal">Postal Code *</label>
                     <input
                       id="f-postal"
                       {...register('postal')}
+                      aria-invalid={!!errors.postal}
                       placeholder="M5V 3A8"
                       maxLength={7}
                       className={errors.postal ? 'field-error' : ''}
                     />
-                    {errors.postal && <p className="error-message">{errors.postal.message}</p>}
+                    {errors.postal && <p className="error-message" role="alert">{errors.postal.message}</p>}
                   </div>
                 </div>
 
-- 
