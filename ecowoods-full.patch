From e01a8c57c55b3d4ec8713b549bf79d1823ae4252 Mon Sep 17 00:00:00 2001
From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Sun, 19 Jul 2026 12:55:25 +0000
Subject: [PATCH 11/11] feat(brand): wire EW monogram into header, footer and
 chat widget
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replaced the decorative leaf glyph in the three logo positions with the EW
mark chip via next/image:
- Header + footer brand-mark: mark on cream (chip bg switched from the
  walnut->oak gradient to --cream-50 so the dark-green mark stays legible).
- ChatWidget launcher FAB and RenoGuide header avatar: mark chips.
The mark is dark green, which disappears on the dark walnut header/hero, so the
consistent treatment everywhere is a cream chip badge — one brand mark that
reads on any background. The leaf remains as a contextual accent in the auth
forms, configurator and command palette (not the logo).
---
 apps/web/app/components/ChatWidget.tsx | 6 +++---
 apps/web/app/components/Header.tsx     | 4 ++--
 apps/web/app/components/SiteFooter.tsx | 4 ++--
 apps/web/app/globals.css               | 2 +-
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/apps/web/app/components/ChatWidget.tsx b/apps/web/app/components/ChatWidget.tsx
index 4176ed5..1bdcfa8 100644
--- a/apps/web/app/components/ChatWidget.tsx
+++ b/apps/web/app/components/ChatWidget.tsx
@@ -1,8 +1,8 @@
 'use client';
 
 import { useState, useEffect, useRef, useCallback } from 'react';
+import Image from 'next/image';
 import { onRenoGuideOpen } from '@/lib/renoguide';
-import { EcowoodsLeaf } from './EcowoodsLeaf';
 
 // Theme-aware by construction: these are CSS custom properties, resolved by
 // the browser on every paint. Flipping data-theme on <html> restyles the whole
@@ -138,7 +138,7 @@ export default function ChatWidget() {
         )}
         {!open && (
           <button className="rg-launch" onClick={() => { setOpen(true); setShowNudge(false); }} aria-label="Chat with RenoGuide" style={{ height: 60, width: 60, borderRadius: 999, border: 'none', cursor: 'pointer', background: `linear-gradient(135deg, ${C.ctaFrom}, ${C.ctaTo})`, color: 'var(--cta-fg)', display: 'grid', placeItems: 'center', animation: 'rg-breathe 3.2s ease-in-out infinite', transition: 'transform .15s ease' }}>
-            <EcowoodsLeaf size={26} strokeWidth={1.5} fillOpacity={0.22} />
+            <Image src="/brand/ew-mark-cream.png" alt="" width={34} height={34} style={{ borderRadius: 9, display: 'block' }} />
           </button>
         )}
       </div>
@@ -147,7 +147,7 @@ export default function ChatWidget() {
         <div role="dialog" aria-label="RenoGuide chat" className="rg-panel" style={{ display: 'flex', flexDirection: 'column', background: C.cream, borderRadius: 22, overflow: 'hidden', border: `1px solid ${C.border}`, boxShadow: '0 24px 60px var(--rg-shadow)', animation: 'rg-pop .26s cubic-bezier(.2,.9,.3,1)' }}>
           <div style={{ display: 'flex', alignItems: 'center', gap: 11, padding: '14px 16px', background: `linear-gradient(135deg, ${C.ctaFrom}, ${C.ctaTo})`, color: 'var(--cta-fg)' }}>
             <span style={{ height: 38, width: 38, borderRadius: 11, background: 'rgba(255,255,255,.16)', display: 'grid', placeItems: 'center' }}>
-              <EcowoodsLeaf size={18} strokeWidth={1.4} fillOpacity={0.22} />
+              <Image src="/brand/ew-mark-cream.png" alt="" width={38} height={38} style={{ borderRadius: 11, display: 'block' }} />
             </span>
             <div style={{ flex: 1, minWidth: 0 }}>
               <div style={{ fontFamily: 'var(--font-fraunces, Georgia), serif', fontSize: 17, fontWeight: 600 }}>RenoGuide</div>
diff --git a/apps/web/app/components/Header.tsx b/apps/web/app/components/Header.tsx
index b413d70..012d0cc 100644
--- a/apps/web/app/components/Header.tsx
+++ b/apps/web/app/components/Header.tsx
@@ -4,7 +4,7 @@ import { useState, useEffect, useRef } from 'react';
 import { useSession, signOut } from 'next-auth/react';
 import ThemeToggle from './ThemeToggle';
 import CommandPalette from './CommandPalette';
-import { EcowoodsLeaf } from './EcowoodsLeaf';
+import Image from 'next/image';
 
 /* ---------------------- Hooks ---------------------- */
 function useScrollState() {
@@ -161,7 +161,7 @@ export default function Header() {
           {/* Brand Lockup */}
           <a className="brand-lockup" href={baseUrl} aria-label="Ecowoods home">
             <span className="brand-mark" aria-hidden="true">
-              <EcowoodsLeaf size={24} />
+              <Image src="/brand/ew-mark-cream.png" alt="" fill sizes="44px" style={{ objectFit: 'cover' }} priority />
             </span>
             <span className="brand-copy">
               <strong>Ecowoods</strong>
diff --git a/apps/web/app/components/SiteFooter.tsx b/apps/web/app/components/SiteFooter.tsx
