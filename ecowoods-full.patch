From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Sun, 19 Jul 2026 12:13:13 +0000
Subject: [PATCH 05/11] chore(web): gate ChatWidget telemetry console.log to
 non-production

The renoguide.opened breadcrumb logged to the browser console on every prod
session. Gated behind NODE_ENV !== 'production' so it stays a dev aid and never
ships; left a note to route it to a real analytics sink.
---
 apps/web/app/components/ChatWidget.tsx | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/apps/web/app/components/ChatWidget.tsx b/apps/web/app/components/ChatWidget.tsx
index 4288ed8..4176ed5 100644
--- a/apps/web/app/components/ChatWidget.tsx
+++ b/apps/web/app/components/ChatWidget.tsx
@@ -108,7 +108,8 @@ export default function ChatWidget() {
       setInput(prefill);
       setTimeout(() => inputRef.current?.focus(), 250);
     }
-    if (source && typeof window !== 'undefined') {
+    if (source && typeof window !== 'undefined' && process.env.NODE_ENV !== 'production') {
+      // Dev-only telemetry breadcrumb; wire to a real analytics sink for prod.
       console.log(JSON.stringify({ event: 'renoguide.opened', source }));
     }
   }), []);
