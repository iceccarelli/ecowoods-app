+   belongs on the content, not on the container. */
+.ff-outro { text-align: center; margin-left: auto; margin-right: auto; }
+.ff-outro h2 { margin-bottom: var(--space-md); }
+.ff-outro p { color: var(--muted); margin-bottom: var(--space-lg); }
+
+.ff-actions {
+  display: flex;
+  gap: var(--space-md);
+  justify-content: center;
+  flex-wrap: wrap;
+}
+
+.ff-cta { text-align: center; }
+.ff-cta h2 { margin-bottom: var(--space-md); }
+.ff-cta p {
