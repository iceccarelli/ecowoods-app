new file mode 100644
index 0000000..241e57d
--- /dev/null
+++ b/old-domain/_redirects
@@ -0,0 +1,10 @@
+# ECOWOODS — ecowoodshardwood.com → ecowoods.ca
+# Netlify. Place at the site root (or in the publish directory).
+#
+# 301! — the bang forces the rule even when a matching file exists in the
+# deploy, which is what makes this a complete redirect rather than one that
+# leaks any page still sitting in the build output.
+#
+# The splat preserves the path; Netlify preserves the query string by default.
+
+/*    https://ecowoods.ca/:splat    301!
diff --git a/old-domain/index.php b/old-domain/index.php
new file mode 100644
index 0000000..bf01372
--- /dev/null
+++ b/old-domain/index.php
@@ -0,0 +1,22 @@
+<?php
+/**
+ * ECOWOODS — ecowoodshardwood.com → ecowoods.ca
+ *
+ * LAST RESORT ONLY. Use this when the host gives no access to server config
+ * and .htaccess is ignored — some shared and managed-WordPress hosts.
+ *
+ * It is worse than a server-level redirect: PHP has to boot to answer, so it
+ * is slower, and it only fires for requests that reach this file. A request
+ * for /old-page.html that resolves to a real file on disk will be served
+ * instead of redirected. Delete every other file in the document root, or this
+ * leaks pages.
+ *
+ * If the host supports .htaccess at all, use that instead and delete this.
+ */
+$path  = $_SERVER['REQUEST_URI'] ?? '/';
+$target = 'https://ecowoods.ca' . $path;
+
+header('HTTP/1.1 301 Moved Permanently');
+header('Location: ' . $target, true, 301);
+header('Cache-Control: max-age=3600');
+exit;
diff --git a/old-domain/nginx.conf b/old-domain/nginx.conf
new file mode 100644
index 0000000..cef714b
--- /dev/null
+++ b/old-domain/nginx.conf
@@ -0,0 +1,35 @@
+# ============================================================================
+# ECOWOODS — ecowoodshardwood.com → ecowoods.ca
+# nginx. Replace the existing server blocks for the old domain entirely.
+# ============================================================================
+#
+# Same rule as the Apache version: ONE hop from every combination of scheme and
+# host straight to the final URL. There is no separate http→https block on
+# purpose — adding one turns every plain-http request into two redirects.
+#
+# $request_uri includes the path AND the original query string, so both survive.
+# Do not use $uri here: it is the decoded path only and it silently drops
+# every ?utm_source= a crawler or an old campaign link is carrying.
+# ============================================================================
+
+server {
+    listen 80;
+    listen [::]:80;
+    server_name ecowoodshardwood.com www.ecowoodshardwood.com;
+    return 301 https://ecowoods.ca$request_uri;
+}
+
+server {
+    listen 443 ssl http2;
+    listen [::]:443 ssl http2;
+    server_name ecowoodshardwood.com www.ecowoodshardwood.com;
+
+    # The certificate must still be valid for the old domain, or an https
+    # request fails at the TLS handshake before it can ever be redirected —
+    # and a browser shows a security warning instead of moving the visitor.
+    # Keep renewing it. A redirect on an expired certificate is a dead end.
+    ssl_certificate     /etc/letsencrypt/live/ecowoodshardwood.com/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/ecowoodshardwood.com/privkey.pem;
+
+    return 301 https://ecowoods.ca$request_uri;
+}
