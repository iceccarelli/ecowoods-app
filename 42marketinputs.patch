@@ -8532,3 +8532,59 @@ html[data-theme='dark'] .fig-band { fill: color-mix(in srgb, var(--copper) 26%,
 .std-stale { color: var(--warning); font-weight: 600; }
 .std .gd-spec { margin-top: 1.2rem; }
 .std .gd-spec dd a { color: var(--copper-text); }
+
+/* ═══════════════════════════════════════════════════════════════════════════
+   MARKET  ·  .mkt-* / .spark-*   —  live commodity inputs
+
+   One series per card, so one hue and no legend — the card title names the
+   measure. Direction is carried by an arrow glyph AND a word ("vs previous"),
+   never by colour alone: --success and --warning measure ΔE 11.7 apart, below
+   the normal-vision floor, so a reader who could not distinguish them would
+   otherwise lose the up/down distinction entirely. See F-96.
+   ═════════════════════════════════════════════════════════════════════════ */
+
+.mkt { background: var(--surface-1); border: 1px solid var(--line);
+  border-left: 3px solid var(--copper); border-radius: 0 14px 14px 0;
+  padding: 1.5rem 1.6rem; scroll-margin-top: 6rem; }
+.mkt-top { display: grid; gap: 1rem; align-items: start;
+  grid-template-columns: minmax(0, 1fr); }
+@media (min-width: 720px) {
+  .mkt-top { grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; }
+}
+.mkt-name { font-family: var(--font-display); font-size: 1.16rem; line-height: 1.3;
+  margin: 0 0 0.3rem; font-weight: 600; color: var(--ink); }
+.mkt-series { margin: 0; font-family: var(--font-mono); font-size: 0.7rem;
+  letter-spacing: 0.05em; color: var(--muted); }
+
+.mkt-figure { display: flex; flex-direction: column; gap: 0.15rem; }
+@media (min-width: 720px) { .mkt-figure { align-items: flex-end; text-align: right; } }
+.mkt-value { font-family: var(--font-display); font-size: 2rem; font-weight: 700;
+  line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
+.mkt-asof { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em;
+  color: var(--muted); max-width: 32ch; }
+.mkt-change { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600;
+  letter-spacing: 0.03em; }
+.mkt-change--up { color: var(--warning); }
+.mkt-change--down { color: var(--success); }
+.mkt-figure--out .mkt-value { color: var(--muted); }
+
+.mkt-spark { margin-top: 1.2rem; }
+.spark { display: block; width: 100%; height: 64px; }
+.spark-line { stroke: var(--copper); stroke-width: 2; stroke-linejoin: round;
+  stroke-linecap: round; vector-effect: non-scaling-stroke; }
+.spark-dot { fill: var(--copper); stroke: var(--surface-1); stroke-width: 2; }
+.mkt-spark-axis { display: flex; justify-content: space-between; margin-top: 0.3rem;
+  font-family: var(--font-mono); font-size: 0.66rem; color: var(--muted); }
+
+.mkt-copy { margin-top: 1.3rem; }
+.mkt-copy h3 { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em;
+  text-transform: uppercase; color: var(--copper-text); margin: 1rem 0 0.35rem; }
+.mkt-copy h3:first-child { margin-top: 0; }
+.mkt-copy p { margin: 0; font-size: 0.94rem; line-height: 1.65; color: var(--ink-soft);
+  max-width: 72ch; }
+
+@media print {
+  .mkt { border: 0; border-top: 1px solid #999; border-radius: 0; padding: 0.6rem 0; }
+  .spark-line { stroke: #6b3410; }
+  .spark-dot { fill: #6b3410; stroke: #fff; }
+}
