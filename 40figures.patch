diff --git a/apps/web/app/data/page.tsx b/apps/web/app/data/page.tsx
new file mode 100644
index 0000000..4366ee7
--- /dev/null
+++ b/apps/web/app/data/page.tsx
@@ -0,0 +1,139 @@
+import type { Metadata } from 'next';
+import Link from 'next/link';
+import { getFigures } from '@/lib/figures';
+import { getPaper } from '@/lib/papers';
+import { FigureChart } from '../components/Figure';
+import { SITE_URL } from '@/lib/seo-data';
+import { buildBreadcrumbList } from '@/lib/schema/builders';
+import { SchemaScript } from '@/lib/schema/components';
+
+/**
+ * /data — the figures, each independently citable.
+ *
+ * Scientific publishing solved this a century ago: number the figures, caption
+ * them, and let each be referenced without the document around it. A figure with
+ * a permalink and a caption is the artifact that ends up in someone else's slide
+ * deck with a URL under it. A table inside a paper is not.
+ *
+ * Each figure emits ImageObject schema pointing at its own anchor, so an answer
+ * engine asked for "Toronto indoor humidity chart" has something addressable to
+ * return rather than a page it would have to describe.
+ */
+
+export const metadata: Metadata = {
+  title: 'Data & Figures | EcoWoods',
+  description:
+    'Charted data on hardwood flooring in Toronto: indoor relative humidity against the band hardwood needs, and Janka hardness for the species used across the GTA. Every value is drawn from a published technical paper and free to reuse under CC BY 4.0.',
+  alternates: { canonical: '/data' },
+  openGraph: {
+    title: 'Data & Figures — EcoWoods',
+    description:
+      'Numbered, captioned, citable figures on Toronto hardwood flooring. Free to reuse with attribution.',
+    type: 'website',
+    url: `${SITE_URL}/data`,
+  },
+};
+
+export default function DataPage() {
+  const figures = getFigures();
+
+  return (
+    <div className="tlx-page">
+      <SchemaScript
+        schema={{
+          '@context': 'https://schema.org',
+          '@type': 'Dataset',
+          '@id': `${SITE_URL}/data#dataset`,
+          name: 'EcoWoods hardwood flooring figures',
+          description:
+            'Charted data on hardwood flooring in Toronto and the GTA, each figure drawn from a published technical paper.',
+          url: `${SITE_URL}/data`,
+          license: 'https://creativecommons.org/licenses/by/4.0/',
+          isAccessibleForFree: true,
+          creator: { '@id': `${SITE_URL}/#organization` },
+          distribution: {
+            '@type': 'DataDownload',
+            encodingFormat: 'application/json',
+            contentUrl: `${SITE_URL}/api/knowledge?collection=figures`,
+          },
+          hasPart: figures.map((f) => ({
+            '@type': 'ImageObject',
+            '@id': `${SITE_URL}/data#fig-${f.id}`,
+            name: `Figure ${f.number} — ${f.title}`,
+            caption: f.caption,
+            url: `${SITE_URL}/data#fig-${f.id}`,
+          })),
+        }}
+      />
+      <SchemaScript
+        schema={buildBreadcrumbList([
+          { name: 'Home', url: SITE_URL },
+          { name: 'Data & Figures', url: `${SITE_URL}/data` },
+        ])}
+      />
+
+      <header className="tlx-hero">
+        <div className="shell">
+          <nav className="tlx-crumbs" aria-label="Breadcrumb">
+            <Link href="/">Home</Link> <span aria-hidden="true">/</span> <span>Data &amp; Figures</span>
+          </nav>
+          <h1 className="tlx-title">Data &amp; figures</h1>
+          <p className="tlx-lede">
+            {figures.length} numbered figures, each drawn from a{' '}
+            <Link href="/papers">technical paper</Link> on this site and each with its own
+            permalink. Every one carries the table it was built from, so the numbers can be checked
+            rather than trusted.
+          </p>
+          <p className="fw-meta">
+            <span>CC BY 4.0 — reuse with attribution</span>
+            <span aria-hidden="true">·</span>
+            <span>
+              <a href="/api/knowledge?collection=figures">JSON</a>
+            </span>
+            <span aria-hidden="true">·</span>
+            <span>Print → Save as PDF</span>
+          </p>
+        </div>
+      </header>
+
+      {figures.map((f) => {
+        const paper = getPaper(f.source.paper);
+        return (
+          <section key={f.id} className="tlx-section" aria-label={`Figure ${f.number}`}>
+            <div className="shell">
+              <FigureChart figure={f} />
+              <p className="fig-source">
+                Source:{' '}
+                <Link href={`/papers/${f.source.paper}#${f.source.section}`}>
+                  {paper ? paper.title : f.source.paper} — {f.source.section.replace(/-/g, ' ')}
+                </Link>{' '}
+                · Permalink: <a href={`/data#fig-${f.id}`}>/data#fig-{f.id}</a>
+              </p>
+            </div>
+          </section>
+        );
+      })}
+
+      <section className="tlx-section" aria-label="Reuse">
+        <div className="shell">
+          <p className="tlx-kicker">Reuse</p>
+          <h2 className="tlx-h2">These are meant to be taken</h2>
+          <p className="tlx-note">
+            Screenshot them, embed them, redraw them from the tables. The licence is CC BY 4.0 and
+            the only condition is attribution by URL. Every figure is server-rendered SVG with the
+            underlying table beside it, so nothing here requires JavaScript, and the machine-readable
+            version of the same data is at <a href="/api/knowledge?collection=figures">/api/knowledge</a>.
+          </p>
+          <div className="fw-actions">
+            <Link className="fw-cta fw-cta--ghost" href="/resources">
+              All resources
+            </Link>
+            <Link className="fw-cta fw-cta--ghost" href="/authority">
+              Citation guide
+            </Link>
+          </div>
+        </div>
+      </section>
+    </div>
+  );
+}
diff --git a/apps/web/app/globals.css b/apps/web/app/globals.css
index 14cabc8..c792a87 100644
--- a/apps/web/app/globals.css
+++ b/apps/web/app/globals.css
@@ -8406,3 +8406,74 @@ html { scroll-padding-top: calc(var(--header-h) + 12px); }
 
   @page { margin: 16mm 14mm; }
 }
+
+/* ═══════════════════════════════════════════════════════════════════════════
+   FIGURES  ·  .fig-*   —  numbered, captioned, citable charts
+
+   ONE HUE. Both figures carry a single series; the humidity band is a reference
+   region rather than a second series, so no categorical palette is involved and
+   the pair-separation problem that killed two earlier colour plans does not
+   arise. See the comment block in app/components/Figure.tsx.
+
+   Grid and axis are recessive — --line, never --ink. Values and labels wear
+   text tokens, never the series colour: the bar carries identity, the number
+   beside it carries the value.
+   ═════════════════════════════════════════════════════════════════════════ */
+
+.fig { margin: 2rem 0 0; padding: 1.6rem 1.7rem; border-radius: 14px;
+  background: var(--surface-1); border: 1px solid var(--line);
+  scroll-margin-top: 6rem; }
+.fig-head { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.1rem; }
+.fig-number { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em;
+  text-transform: uppercase; color: var(--copper-text); }
+.fig-head h3 { font-family: var(--font-display); font-size: 1.14rem; font-weight: 600;
+  line-height: 1.3; margin: 0; color: var(--ink); }
+
+.fig-plot { width: 100%; overflow-x: auto; }
+.fig-plot svg { display: block; width: 100%; min-width: 520px; height: auto; }
+
+.fig-bar   { fill: var(--copper); }
+/* The reference region is context. It must read as behind the data, which means
+   low chroma and no border competing with the marks. */
+.fig-band  { fill: color-mix(in srgb, var(--copper) 14%, transparent); }
+/* 14% of copper over a cream surface reads as a soft tint; over the near-black
+   dark surface the same mix nearly disappears. Rendered both and measured — the
+   dark step is chosen, not derived, which is the rule for every dark value in
+   this file. */
+html[data-theme='dark'] .fig-band { fill: color-mix(in srgb, var(--copper) 26%, transparent); }
+.fig-grid  { stroke: var(--line); stroke-width: 1; }
+.fig-axis  { stroke: var(--line); stroke-width: 1; }
+.fig-label { fill: var(--ink-soft); font-family: var(--font-body); font-size: 13px; }
+.fig-value { fill: var(--ink); font-family: var(--font-mono); font-size: 12px;
+  font-variant-numeric: tabular-nums; }
+.fig-tick  { fill: var(--muted); font-family: var(--font-mono); font-size: 11px;
+  text-anchor: middle; }
+.fig-unit  { fill: var(--muted); font-family: var(--font-mono); font-size: 11px;
+  letter-spacing: 0.05em; }
+
+.fig-caption { margin: 1.1rem 0 0; font-size: 0.92rem; line-height: 1.65;
+  color: var(--ink-soft); max-width: 72ch; }
+
+.fig-table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; font-size: 0.88rem; }
+.fig-table caption { text-align: left; font-family: var(--font-mono); font-size: 0.68rem;
+  letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
+  padding-bottom: 0.5rem; }
+.fig-table th, .fig-table td { text-align: left; padding: 0.5rem 0.75rem;
+  border-bottom: 1px solid var(--line); }
+.fig-table thead th { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.07em;
+  text-transform: uppercase; color: var(--muted); }
+.fig-table tbody th { font-weight: 600; color: var(--ink); }
+.fig-table td { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
+.fig-table tbody tr:last-child th, .fig-table tbody tr:last-child td { border-bottom: 0; }
+
+@media print {
+  .fig { border: 0; border-top: 1px solid #999; border-radius: 0; padding: 0.6rem 0;
+    break-inside: avoid; }
+  .fig-plot { overflow: visible; }
+  .fig-plot svg { min-width: 0; }
+  /* currentColor would resolve to the print ink; the bars need to stay filled. */
+  .fig-bar { fill: #6b3410; }
+  .fig-band { fill: #e6d8cc; }
+}
+.fig-source { margin: 0.9rem 0 0; font-size: 0.85rem; line-height: 1.6; color: var(--muted); }
+.fig-source a { color: var(--copper-text); }
