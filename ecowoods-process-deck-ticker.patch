diff --git a/apps/web/app/globals.css b/apps/web/app/globals.css
index 97d0ce2..30317ec 100644
--- a/apps/web/app/globals.css
+++ b/apps/web/app/globals.css
@@ -4897,3 +4897,177 @@ html { scroll-padding-top: calc(var(--header-h) + 12px); }
 .pfd-card--review .pfd-quote {
   font-size: clamp(1.05rem, 4.4vw, 1.32rem);
 }
+
+/* ============================================================
+   SERVICE TICKER (.svt) — exchange-style flowing service list
+   Sits directly above "How It Works". Two identical runs inside the track;
+   the loop translates by exactly 50% so the wrap is seamless. Motion is
+   left -> right, with the viewport masked at both edges so items fade in on
+   the left and dissolve on the right rather than clipping.
+   ============================================================ */
+.svt {
+  margin-top: 2.5rem;
+}
+.svt-viewport {
+  overflow: hidden;
+  /* edge fade — mask keeps it transparent over any section background */
+  -webkit-mask-image: linear-gradient(
+    to right,
+    transparent 0%,
+    #000 12%,
+    #000 88%,
+    transparent 100%
+  );
+  mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
+}
+.svt-track {
+  display: flex;
+  width: max-content;
+  animation-name: svt-flow;
+  animation-timing-function: linear;
+  animation-iteration-count: infinite;
+  will-change: transform;
+}
+/* start shifted one full run to the left, settle at 0 => rightward travel */
+@keyframes svt-flow {
+  from {
+    transform: translate3d(-50%, 0, 0);
+  }
+  to {
+    transform: translate3d(0, 0, 0);
+  }
+}
+.svt-run {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  padding-right: 0.6rem;
+  flex: 0 0 auto;
+}
+/* let readers stop the motion to actually read a value */
+.svt:hover .svt-track,
+.svt:focus-within .svt-track {
+  animation-play-state: paused;
+}
+
+.svt-item {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.6rem;
+  flex: 0 0 auto;
+  padding: 0.5rem 1rem;
+  border-radius: var(--radius-full);
+  font-size: 0.85rem;
+  font-weight: 500;
+  white-space: nowrap;
+  color: rgba(245, 239, 230, 0.85);
+  background: rgba(245, 239, 230, 0.05);
+  border: 1px solid rgba(245, 239, 230, 0.14);
+}
+.svt-label {
+  color: inherit;
+}
+.svt-value {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.25rem;
+  font-family: var(--font-mono);
+  font-size: 0.78rem;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+  padding-left: 0.6rem;
+  border-left: 1px solid rgba(245, 239, 230, 0.16);
+}
+.svt-value--up {
+  color: var(--copper-bright);
+}
+.svt-value--down {
+  color: rgba(245, 239, 230, 0.55);
+}
+.svt-value--flat {
+  color: rgba(245, 239, 230, 0.7);
+}
+.svt-trend {
+  font-size: 0.62rem;
+  line-height: 1;
+}
+
+.svt-sr {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .svt-track {
+    animation: none;
+  }
+}
+
+/* ============================================================
+   SWIPE DECK — LIGHT CARD VARIANT (How It Works steps)
+   The pillars/reviews decks sit on dark sections; #process is a light paper
+   section, so its cards invert to match rather than punching a dark hole.
+   ============================================================ */
+.pfd-card--light {
+  background: var(--surface-1, #fff);
+  border: 1px solid var(--line);
+  box-shadow:
+    0 1px 2px rgba(26, 15, 8, 0.05),
+    0 18px 40px -16px rgba(26, 15, 8, 0.18);
+}
+.pfd-card--step {
+  justify-content: flex-start;
+  gap: 1rem;
+  padding: 2.1rem 1.9rem;
+}
+.pfd-step-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 0.4rem;
+}
+.pfd-step-icon {
+  width: 56px;
+  height: 56px;
+  display: grid;
+  place-items: center;
+  border-radius: 14px;
+  color: var(--copper-deep);
+  background: rgba(176, 109, 58, 0.1);
+}
+.pfd-step-icon svg {
+  width: 26px;
+  height: 26px;
+}
+.pfd-step-num {
+  font-family: var(--font-display);
+  font-size: 2.6rem;
+  font-weight: 300;
+  line-height: 1;
+  color: var(--line);
+}
+.pfd-step-title {
+  margin: 0;
+  font-family: var(--font-display);
+  color: var(--ink, var(--walnut-950));
+  font-size: 1.5rem;
+  line-height: 1.14;
+  letter-spacing: -0.01em;
+}
+.pfd-step-body {
+  margin: 0;
+  color: var(--muted);
+  font-size: 1rem;
+  line-height: 1.55;
+}
+/* light cards need a dark-on-light drag flag */
+.pfd-card--light .pfd-flag {
+  background: var(--copper-deep);
+}
