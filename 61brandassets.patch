+  printf '  %sFAIL%s  %-34s no logo in the organisation schema\n' "$RED" "$OFF" "Organization logo"
+  FAILED=$((FAILED + 1))
+else
+  check "Organization logo bytes" "$LOGO"
+  printf '  %s····%s  %-34s %s\n' "$DIM" "$OFF" "resolved to" "$(printf '%s' "$LOGO" | cut -c1-58)"
+fi
+
