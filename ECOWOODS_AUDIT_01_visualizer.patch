+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { existsSync } from 'node:fs';
+import path from 'node:path';
+
+const ROOT = path.resolve(fileURLToPath(import.meta.url), '../../..');
+const WEB = path.join(ROOT, 'apps/web');
+const SHARED = path.join(ROOT, 'packages/shared');
+
+export async function resolve(spec, ctx, next) {
+  let target = null;
+  if (spec.startsWith('@ecowoods/shared/')) {
+    target = path.join(SHARED, spec.slice('@ecowoods/shared/'.length));
+  } else if (spec === '@ecowoods/shared') {
+    target = path.join(SHARED, 'index');
+  } else if (spec.startsWith('@/')) {
+    target = path.join(WEB, spec.slice(2));
+  } else if (spec.startsWith('.') && ctx.parentURL) {
+    target = path.resolve(path.dirname(fileURLToPath(ctx.parentURL)), spec);
+  }
+  if (target) {
+    for (const cand of [target, target + '.ts', target + '.tsx', path.join(target, 'index.ts')]) {
+      if (existsSync(cand) && !cand.endsWith('/')) {
+        try { const st = (await import('node:fs')).statSync(cand); if (st.isDirectory()) continue; } catch {}
+        return { url: pathToFileURL(cand).href, format: cand.endsWith('.ts') || cand.endsWith('.tsx') ? 'module-typescript' : 'module', shortCircuit: true };
+      }
+    }
+  }
+  return next(spec, ctx);
+}
