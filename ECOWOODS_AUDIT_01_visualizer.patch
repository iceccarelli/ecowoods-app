+/**
+ * scripts/audit/boundary.audit.ts — AV-02.
+ *
+ * THE QUESTION: when the studio says `measured`, is it?
+ *
+ * room.ts offers exactly two confidence values and argues, correctly, that a
+ * percentage would be "a claim about a distribution nobody estimated". The
+ * argument is right. This script tests the boundary between the two values.
+ *
+ * Six synthetic rooms, each with a floor plane whose true coverage is known by
+ * construction. The estimator is run on each and its reported coverage is
+ * compared against the truth. A run is honest if it says `measured` and is
+ * close, or says `weak` at all. It is dishonest if it says `measured` and is
+ * not.
+ *
+ * The interesting case is the third one: a room with a rug. That is not an edge
+ * case, it is the most common photograph a homeowner will upload.
+ */
+import { analyseRoom, quadCoverage } from '@/lib/floor-studio/room';
+const W=480,H=320;
+function room(opts:{rug?:boolean;furniture?:boolean;angle?:boolean;darkFloor?:boolean}){
+  const data=new Uint8ClampedArray(W*H*4);
+  const put=(x:number,y:number,r:number,g:number,b:number)=>{const i=(y*W+x)*4;data[i]=r;data[i+1]=g;data[i+2]=b;data[i+3]=255;};
+  const TRUE_HORIZON=0.45;
+  for(let y=0;y<H;y++)for(let x=0;x<W;x++){const ny=y/H;
+    let fy=TRUE_HORIZON;
+    if(opts.angle) fy=0.30+0.30*(x/W);           // floor line runs diagonally (photo from a doorway)
+    if(ny<fy)put(x,y,236,233,228);
+    else{const d=1-0.18*(1-ny);const base=opts.darkFloor?[70,52,38]:[150,112,74];
+      put(x,y,base[0]!*d,base[1]!*d,base[2]!*d);}}
+  if(opts.rug)for(let y=Math.round(0.60*H);y<Math.round(0.85*H);y++)for(let x=Math.round(0.15*W);x<Math.round(0.85*W);x++)put(x,y,214,206,190);
+  if(opts.furniture)for(let y=Math.round(0.48*H);y<Math.round(0.70*H);y++)for(let x=Math.round(0.05*W);x<Math.round(0.40*W);x++)put(x,y,138,136,132);
+  return {data,width:W,height:H};
+}
+const TRUE_COVERAGE_FLAT = 0.55; // floor from y=0.45 to 1.0, full width
+const cases: [string, any, number][] = [
+  ['empty room, oak floor',            {},                                 TRUE_COVERAGE_FLAT],
+  ['dark walnut floor',                {darkFloor:true},                   TRUE_COVERAGE_FLAT],
+  ['with a large pale area rug',       {rug:true},                         TRUE_COVERAGE_FLAT],
+  ['with a sofa',                      {furniture:true},                   TRUE_COVERAGE_FLAT],
+  ['rug + sofa (a real living room)',  {rug:true,furniture:true},          TRUE_COVERAGE_FLAT],
+  ['shot from a doorway (angled)',     {angle:true},                       0.55],
+];
+console.log('SCENE                              confidence   coverage   true    error   label honest?');
+for(const [name,opts,truth] of cases){
+  const r=analyseRoom(room(opts));
+  const err=Math.abs(r.floorCoverage-truth)/truth;
+  const honest = (r.floorConfidence==='measured' && err<0.25) || (r.floorConfidence==='weak');
+  console.log(name.padEnd(34), r.floorConfidence.padEnd(12), r.floorCoverage.toFixed(3).padStart(8), truth.toFixed(2).padStart(7),
+    (100*err).toFixed(0).padStart(6)+'%', '  ', honest?'yes':'NO — says "measured" while wrong');
+}
