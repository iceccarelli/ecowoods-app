+/**
+ * scripts/audit/occlusion.audit.ts — AV-01.
+ *
+ * THE QUESTION: when Floor Studio lays a floor into a photograph, what does it
+ * destroy on the way?
+ *
+ * The renderer's own docblock promises that "a sofa leg, a rug, a plant pot
+ * inside the quad is not floor and must not be painted over". This script does
+ * not take that on trust. It builds a room whose floor plane is known exactly,
+ * stands fourteen ordinary objects on it, runs the real compositeFloor(), and
+ * counts the pixels of each object that came back changed.
+ *
+ * The objects are not adversarial. They are what is on the floor of a house
+ * that is about to buy hardwood: a sofa, two rugs, a plant, a person, a cat, a
+ * dog, a cabinet toe-kick, a stair riser, a table leg, a box, an armchair, a
+ * pot and a lamp base.
+ *
+ * Ground truth is exact because the room is synthetic: every object's box is
+ * known, so "was this pixel of the dog replaced" is a comparison, not a
+ * judgement. Run it; do not read it.
+ */
+import { compositeFloor } from '@/lib/floor-studio/render';
+const W=480,H=320;
+type Obj={name:string;rgb:[number,number,number];box:[number,number,number,number]};
+// every object tiled along the true floor band so all are inside one honest quad
+const NAMES: [string,[number,number,number]][] = [
+  ['grey fabric sofa',[138,136,132]],
+  ['cream/jute area rug',[214,196,166]],
+  ['charcoal rug',[52,52,56]],
+  ['green plant',[62,110,58]],
+  ['human leg (skin)',[206,160,128]],
+  ['black cat',[28,26,26]],
+  ['golden retriever',[198,158,104]],
+  ['white cabinet toe-kick',[238,236,232]],
+  ['oak stair riser',[168,128,84]],
+  ['pine/oak table leg',[176,140,96]],
+  ['cardboard box',[190,158,116]],
+  ['navy armchair',[46,58,88]],
+  ['terracotta pot',[178,98,62]],
+  ['brass floor lamp base',[186,152,74]],
+];
+function build(){
+  const data=new Uint8ClampedArray(W*H*4);
+  const put=(x:number,y:number,r:number,g:number,b:number)=>{const i=(y*W+x)*4;data[i]=r;data[i+1]=g;data[i+2]=b;data[i+3]=255;};
+  for(let y=0;y<H;y++)for(let x=0;x<W;x++){const ny=y/H;
+    if(ny<0.45)put(x,y,236,233,228);else{const d=1-0.18*(1-ny);put(x,y,150*d,112*d,74*d);}}
+  const objs:Obj[]=[];
+  NAMES.forEach((n,i)=>{
+    const col=i%7, row=Math.floor(i/7);
+    const x0=0.02+col*0.14, y0=0.50+row*0.24;
+    const box:[number,number,number,number]=[x0,y0,x0+0.11,y0+0.19];
+    objs.push({name:n[0],rgb:n[1],box});
+    for(let y=Math.round(box[1]*H);y<Math.round(box[3]*H);y++)
+      for(let x=Math.round(box[0]*W);x<Math.round(box[2]*W);x++)
+        if(x>=0&&x<W&&y>=0&&y<H)put(x,y,n[1][0],n[1][1],n[1][2]);
+  });
+  return {px:{data,width:W,height:H},objs};
+}
+const {px,objs}=build();
+const quad=[{x:0.10,y:0.46},{x:0.90,y:0.46},{x:1,y:1},{x:0,y:1}] as any;
+const res=compositeFloor(px,quad,{productId:'white-oak',finishId:'satin',patternId:'straight',widthId:'5'},{squareFeet:400});
+console.log('painted fraction of quad:',res.painted.toFixed(3),res.failure??'');
+console.log('');
+console.log('OBJECT ON THE FLOOR          in-quad  overwritten     %   VERDICT');
+for(const o of objs){
+  let n=0,c=0;
+  for(let y=Math.round(o.box[1]*H);y<Math.round(o.box[3]*H);y++)
+    for(let x=Math.round(o.box[0]*W);x<Math.round(o.box[2]*W);x++){
+      const nx=(x+0.5)/W,ny=(y+0.5)/H;
+      let sign=0,inside=true;
+      for(let i=0;i<4;i++){const a=quad[i],b=quad[(i+1)%4];
+        const cr=(b.x-a.x)*(ny-a.y)-(b.y-a.y)*(nx-a.x);if(cr===0)continue;
+        const s=cr>0?1:-1;if(sign===0)sign=s;else if(s!==sign){inside=false;break;}}
+      if(!inside)continue;n++;
+      const i=(y*W+x)*4;
+      if(res.pixels.data[i]!==px.data[i]||res.pixels.data[i+1]!==px.data[i+1]||res.pixels.data[i+2]!==px.data[i+2])c++;
+    }
+  const p=n?100*c/n:0;
+  console.log(o.name.padEnd(28),String(n).padStart(7),String(c).padStart(12),p.toFixed(1).padStart(7),' ',n===0?'n/a':p<5?'PRESERVED':p<50?'PARTIAL':'PAINTED OVER');
+}
