+  it('falls back to exploded when --fa-t is never set', () => {
+    expect(css).toContain('var(--fa-z) * var(--fa-f, 0) * var(--fa-t, 1)');
+    expect(css).toContain(".fa-stage[data-collapsed='true'] {");
