+  padding-top: 0.2rem;
+}
+
+.fa-t {
+  font-weight: 600;
+  margin: 0 0 0.25rem;
+  color: var(--on-dark);
+}
+
+.fa-d {
+  margin: 0;
+  color: var(--on-dark-muted);
+  font-size: var(--fs-sm);
+  line-height: 1.6;
+}
+
+/* the question. This is the part a visitor screenshots and takes to the
+   competitor, which is exactly what it is for. */
+.fa-ask {
+  margin: 0.5rem 0 0;
+  font-size: var(--fs-sm);
+  line-height: 1.55;
+  color: var(--on-dark-muted);
+  border-left: 2px solid var(--copper-bright);
+  padding-left: var(--space-sm);
+}
+
+.fa-ask-label {
+  color: var(--copper-bright);
+  font-weight: 600;
+}
+
+.fa-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-md);
+}
+
+@media (max-width: 700px) {
+  .fa-stage {
+    --fa-z: 104px;
+    --fa-rot: -22deg;
+    --fa-w: min(360px, 72vw);
+  }
+  .fa-item {
+    grid-template-columns: 1.75rem 1fr;
+    gap: var(--space-sm);
+  }
+}
+
+/* The graphic never animates for somebody who asked it not to. It is already
+   in its final, readable state; this removes the transition so a species
+   switch or a legend hover changes it instantly rather than gliding. */
+@media (prefers-reduced-motion: reduce) {
+  .fa-layer {
+    transition: none;
+    transition-delay: 0s;
