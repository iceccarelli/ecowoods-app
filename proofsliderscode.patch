+/* ═══════════════════════════════════════════════════════════════════════
+   PROOF SLIDER  —  app/components/ProofSlider.tsx
+   The control is a native <input type="range">, styled to look like a handle
+   rather than replaced by one: that is where the keyboard, the touch drag and
+   the screen-reader announcement all come from for free.
+   ═══════════════════════════════════════════════════════════════════════ */
+.ps { margin: 0; }
+
+.ps-head { max-width: 62ch; margin-bottom: 1.25rem; }
+.ps-kicker {
+  margin: 0 0 0.5rem;
+  font-family: var(--font-mono);
+  font-size: var(--fs-2xs);
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--copper-text);
+}
+.ps-headline {
+  margin: 0 0 0.6rem;
+  font-family: var(--font-display);
+  font-weight: 600;
+  line-height: 1.15;
+  font-size: clamp(1.5rem, 2.6vw, 2.1rem);
+  color: var(--ink);
+}
+.ps-factline { margin: 0; color: var(--muted); line-height: 1.6; }
+
+.ps-frame {
+  position: relative;
+  aspect-ratio: 3 / 2;          /* every frame is 1920x1280 — exactly 3:2 */
+  overflow: hidden;
+  border-radius: 16px;
+  border: 1px solid var(--line);
+  background: var(--surface-2, var(--surface-1));
+  isolation: isolate;
+  touch-action: pan-y;          /* vertical scroll still works over the frame */
+}
+.ps-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+
+/* The AFTER frame is CLIPPED, never display:none — both images stay in the DOM
+   so a crawler and a reader-mode parser receive both. */
+.ps-after {
+  position: absolute;
+  inset: 0;
+  clip-path: inset(0 0 0 var(--ps-pos));
+  transition: clip-path 90ms linear;
+}
+@media (prefers-reduced-motion: reduce) {
+  /* No autoplay exists to disable; the only motion is the visitor's own. This
+     removes the easing and leaves the control fully working. */
+  .ps-after { transition: none; }
+}
+
+.ps-tag {
+  position: absolute;
+  top: 0.85rem;
+  z-index: 3;
+  padding: 0.3rem 0.7rem;
+  border-radius: var(--radius-full);
+  font-family: var(--font-mono);
+  font-size: var(--fs-2xs);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: #fff;
+  background: rgba(26, 20, 16, 0.62);
+  backdrop-filter: blur(6px);
+  pointer-events: none;
+}
+.ps-tag-left { left: 0.85rem; }
+.ps-tag-right { right: 0.85rem; }
+
+.ps-line {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: var(--ps-pos);
+  z-index: 4;
+  width: 2px;
+  margin-left: -1px;
+  background: rgba(255, 255, 255, 0.92);
+  box-shadow: 0 0 0 1px rgba(26, 20, 16, 0.22);
+  pointer-events: none;
+}
+.ps-knob {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  transform: translate(-50%, -50%);
+  display: grid;
+  place-items: center;
+  width: 44px;                  /* the WCAG 2.5.8 AA floor, and a thumb's size */
+  height: 44px;
+  border-radius: 50%;
+  background: var(--surface-1);
+  color: var(--ink);
+  box-shadow: 0 2px 10px rgba(26, 20, 16, 0.28);
+}
+
+/* The real control. Transparent, full-bleed, and on top of everything. */
+.ps-range {
+  position: absolute;
+  inset: 0;
+  z-index: 5;
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  opacity: 0;
+  cursor: ew-resize;
+  -webkit-appearance: none;
+  appearance: none;
+  background: transparent;
+}
+.ps-range::-webkit-slider-thumb { -webkit-appearance: none; width: 44px; height: 100%; }
+.ps-range::-moz-range-thumb { width: 44px; height: 100%; border: 0; opacity: 0; }
+/* Focus lands on an invisible input, so the ring is drawn on the knob it drives. */
+.ps-range:focus-visible ~ .ps-line .ps-knob,
+.ps-frame:has(.ps-range:focus-visible) .ps-knob {
+  outline: 3px solid var(--copper-bright, var(--copper));
+  outline-offset: 3px;
+}
+
+.ps-caption {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem 1.25rem;
+  margin-top: 0.9rem;
+}
+.ps-hint {
+  font-family: var(--font-mono);
+  font-size: var(--fs-xs);
+  letter-spacing: 0.06em;
+  color: var(--muted);
+}
+.ps-cta {
+  display: inline-flex; align-items: center; gap: 0.4rem; min-height: 24px;
+  font-size: var(--fs-sm);
+  font-weight: 600;
+  color: var(--copper-text, var(--copper));
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.ps-cta:focus-visible { outline: 2px solid var(--copper-bright); outline-offset: 3px; }
+
+@media (max-width: 560px) {
+  .ps-tag { top: 0.6rem; font-size: 10px; padding: 0.25rem 0.55rem; }
+  .ps-tag-left { left: 0.6rem; }
+  .ps-tag-right { right: 0.6rem; }
+}
