 package.json                     |  2 +-
 scripts/render-api-test.mjs      | 74 ++++++++++++++++++++++++++++++++
 services/render-api/README.md    | 20 +++++++++
 services/render-api/package.json |  5 ++-
 4 files changed, 99 insertions(+), 2 deletions(-)
