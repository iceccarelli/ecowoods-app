+++ b/apps/web/app/globals.css
@@ -5452,3 +5452,39 @@ html { scroll-padding-top: calc(var(--header-h) + 12px); }
 .sheet-pad {
   padding: 1.1rem 1rem 2rem;
 }
+
+/* ============================================================
+   COUNTUP — rolling hero numbers
+   The live number is absolutely positioned over a hidden sizer holding the
+   FINAL string, so the element is born at its finished width. Counting from
+   "0" to "5,200" would otherwise widen the cell mid-animation and shove the
+   whole trust bar around — undoing the subgrid alignment.
+   ============================================================ */
+.countup {
+  position: relative;
+  display: inline-grid;
+  font-variant-numeric: tabular-nums lining-nums;
+}
+.countup-sizer {
+  visibility: hidden;
+  grid-area: 1 / 1;
+}
+.countup-live {
+  grid-area: 1 / 1;
+  justify-self: start;
+  white-space: nowrap;
+}
+
+/* visually-hidden utility — this codebase had none; the decks each rolled
+   their own (.pfd-sr, .svt-sr). One definition, reusable. */
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
