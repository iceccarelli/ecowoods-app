+    `${staticRoutes.size} static route(s), ` +
+    `${Object.values(MANIFESTS).length} manifest(s), ` +
+    `${counts['frag ok'] ?? 0} same-page anchor(s), ` +
+    `${counts['ext ok'] ?? 0} external link(s); no 404, no redirect hop, no retired domain`,
+);
