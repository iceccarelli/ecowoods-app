+const sources = [];
+(function walk(dir) {
+  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+    const p = path.join(dir, e.name);
+    if (e.isDirectory()) {
+      if (['node_modules', '.next', '.turbo', 'public'].includes(e.name)) continue;
+      walk(p);
+    } else if (/\.(tsx|ts|mdx)$/.test(e.name)) {
