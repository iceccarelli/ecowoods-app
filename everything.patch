+
+/* ── 2. public/ ──────────────────────────────────────────────────────────── */
+const publicFiles = new Set();
+const PUBLIC_DIRS = [path.join(WEB, 'public'), path.join(ROOT, 'public')];
+for (const base of PUBLIC_DIRS) {
+  if (!fs.existsSync(base)) continue;
