+  for (const m of src.matchAll(/href:\s*['"`](https?:\/\/[^'"`]+)['"`]/g)) {
+    try { ALLOWED_EXTERNAL.add(new URL(m[1]).hostname); found++; } catch { /* not a URL */ }
