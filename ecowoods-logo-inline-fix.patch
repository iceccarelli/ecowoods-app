diff --git a/apps/web/lib/brand.ts b/apps/web/lib/brand.ts
new file mode 100644
index 0000000..24e6cb0
--- /dev/null
+++ b/apps/web/lib/brand.ts
@@ -0,0 +1,12 @@
+/**
+ * EW_MARK — the Ecowoods monogram inlined as a base64 data URI.
+ *
+ * Why inline and not a file in /public: a logo must never 404. Serving it as a
+ * static asset made it depend on the deploy serving /brand/ correctly and on the
+ * next/image optimizer (sharp) — both of which broke it in production. As a data
+ * URI it ships inside the bundle: no network request, no optimizer, no
+ * deploy-config dependency. It renders the instant the component mounts, every
+ * time. It is the cream-chip version (self-contained cream background) so it
+ * reads on any header/footer/chat colour. ~2.2KB, quantized.
+ */
+export const EW_MARK = 'data:image/png;base64,';
