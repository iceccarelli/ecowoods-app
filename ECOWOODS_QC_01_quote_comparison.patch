+export { SCOPE_ITEMS, SCOPE_GROUPS } from '@/content/quote-check/scope-items';
+export type { ScopeItem, ScopeBasis } from '@/content/quote-check/scope-items';
+export {
+  compare,
+  perSquareFoot,
+  isEntered,
+  benchmarkRow,
+} from './compare';
+export type { QuoteInput, QuoteReading, Comparison, Verdict, BenchmarkRow } from './compare';
