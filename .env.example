# Ecowoods — environment variables, as the application actually reads them.
#
# WHAT THIS FILE USED TO BE
#
# Until HYG-03 this file documented POSTGRES_USER, POSTGRES_PASSWORD,
# API_PORT, SECRET_KEY, DEBUG and CORS_ORIGINS. Not one of those is read
# anywhere in apps/web or packages/*. They belong to backend/ — a Python
# FastAPI project that is not in pnpm-workspace.yaml, is not built by turbo,
# is not deployed by either vercel.json, and shares no code with the site
# that serves ecowoods.ca.
#
# So the one file whose entire job is to tell a new contributor what to
# configure was describing a different application, and the forty-one
# variables the real one reads were written down nowhere. That is worse than
# an empty file: an empty file makes somebody go and look.
#
# Every variable below was extracted from the source. Each says what breaks
# without it, because "optional" with no consequence attached gets read as
# "ignore this" and then something is silently off in production for a month.
#
# Copy to .env.local for development.

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — the site does not work without these
# ─────────────────────────────────────────────────────────────────────────

# Postgres connection string. Everything commercial stops without it: leads
# fall through to the durable log, the portal cannot render, the admin
# screens 500.
DATABASE_URL=

# Direct (non-pooled) connection. Prisma migrations use this; the pooled
# DATABASE_URL cannot run DDL. Read by prisma/schema.prisma only.
DIRECT_URL=

# Sessions. Without it Auth.js cannot sign a cookie and nobody can log in —
# not a customer to /mypage, not an admin to /admin.
NEXTAUTH_SECRET=
# The absolute origin. Wrong here means password-reset and verification
# emails contain links to the wrong host.
NEXTAUTH_URL=https://ecowoods.ca

# The canonical origin used for schema.org, sitemaps, feeds and every
# absolute URL the machine surfaces emit.
NEXT_PUBLIC_SITE_URL=https://ecowoods.ca

# ─────────────────────────────────────────────────────────────────────────
# LEADS AND NOTIFICATION — set these or leads arrive nowhere
# ─────────────────────────────────────────────────────────────────────────

# Where a new lead is emailed. Unset, the lead is still captured in the
# database and the durable log, and nobody is told about it.
ADMIN_EMAIL=

# Resend is tried first. Without it lib/email falls back to SMTP; without
# both, email is logged to the console and never sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP fallback, used only when RESEND_API_KEY is absent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SALE-04 — the text message to the estimating desk when a lead arrives.
# All four are required together; with any missing, lead-alert logs one line
# and sends nothing. ALERT_SMS_TO is E.164, comma-separated for more than
# one estimator. Declared as a data processor in lib/legal.ts and rendered
# on /privacy — if you change provider, change that too.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# Optional CRM hook. A public https URL, SSRF-guarded by lib/outbound-webhook.
LEADS_WEBHOOK_URL=
PILOT_LEADS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────
# PAYMENTS
# ─────────────────────────────────────────────────────────────────────────

# Without these, invoices render but cannot be paid online and the webhook
# that marks them PAID never fires. The build prints a warning and continues.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# AI
# ─────────────────────────────────────────────────────────────────────────

# EcowoodsGuide, the chat assistant. Unset, the widget renders and the route
# cannot answer.
ANTHROPIC_API_KEY=

# lib/ai.ts falls back to template responses when this is absent. That is a
# designed fallback, not a failure.
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# STORAGE — where generated PDFs go
# ─────────────────────────────────────────────────────────────────────────

# Vercel Blob first, then Supabase, then the local filesystem. The local
# fallback does NOT survive a serverless deploy: on Vercel with neither token
# set, a generated quote PDF is written to a disk that disappears.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# SCHEDULED WORK
# ─────────────────────────────────────────────────────────────────────────

# Bearer token for /api/cron/*. Unset, the quote-recovery and review-request
# sweeps registered in vercel.json return 401 every hour, silently.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — social login, each independent
# ─────────────────────────────────────────────────────────────────────────

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — analytics, verification, media
# ─────────────────────────────────────────────────────────────────────────

# GA4. Loads only after the visitor consents in the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_YOUTUBE_PROCESS_ID=

# /api/backgrounds returns an empty list when this is unset or a placeholder.
UNSPLASH_ACCESS_KEY=

# Client error reporting. ERROR_WEBHOOK_TIMEOUT_MS defaults if unset.
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TIMEOUT_MS=

# ─────────────────────────────────────────────────────────────────────────
# NOT SET BY HAND
# ─────────────────────────────────────────────────────────────────────────
#
# NODE_ENV, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA — supplied by the platform.
#
# INDEXNOW_KEY is read from a file in the repository, NOT from the
# environment. See app/api/indexnow and F-158: it was an env var, and the
# guard that checks the published key file could not see it.
