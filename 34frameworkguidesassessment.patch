@@ -7965,3 +7965,234 @@ html { scroll-padding-top: calc(var(--header-h) + 12px); }
   .fc-swatches, .fc-pills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
   .fc-pills[data-count='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
 }
+
+/* ═══════════════════════════════════════════════════════════════════════════
+   FRAMEWORK  ·  .fw-*   —  the Well-Installed Framework and its self-assessment
+
+   A component namespace INSIDE the .tlx-* editorial system, exactly as .wp-* is
+   for the papers. Not a third design system: every surface, line and text
+   colour below comes from the same semantic tokens .tlx-* uses, so the two
+   cannot drift apart and neither needs its own theme pass.
+
+   No primitive token (--walnut-*, --oak-*, --cream-*, --maple-*) is referenced
+   here. Status colour comes from --success / --warning / --danger, which carry
+   measured contrast ratios in the token block at the top of this file.
+   ═════════════════════════════════════════════════════════════════════════ */
+
+.fw-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.75rem; margin: 1.1rem 0 0;
+  font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.05em;
+  text-transform: uppercase; color: var(--muted); }
+
+.fw-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.6rem; }
+.fw-cta { display: inline-flex; align-items: center; min-height: 44px;
+  padding: 0.7rem 1.35rem; border-radius: 999px; text-decoration: none;
+  font-weight: 600; font-size: 0.95rem; line-height: 1.2;
+  background: var(--copper); color: var(--on-dark);
