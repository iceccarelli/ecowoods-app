+          </p>
+          <div className="fw-actions">
+            <Link className="fw-cta" href="/framework/assess">
+              Score a quote against it →
+            </Link>
+            <Link className="fw-cta fw-cta--ghost" href="/framework">
+              Read the specification
+            </Link>
+          </div>
+        </div>
+      </section>
+    </div>
+  );
+}
