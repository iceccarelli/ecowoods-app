+/* ============================================================================
+   VIS-05 — THE EXPLODED FLOOR ASSEMBLY  (.fa-*)
+   ----------------------------------------------------------------------------
+   A five-layer CSS-3D stack that pulls apart, with the real photographed grain
+   crop from public/textures on the wear layer.
+
+   THE EXPLODED STATE IS THE DEFAULT, and that is load-bearing rather than
+   stylistic. With no JavaScript — which includes several of the answer engines
+   this site is written for — and under prefers-reduced-motion, the graphic
+   renders open, annotated and readable. `[data-collapsed]` is applied by script
+   only when the section is off screen, so the reveal is never a flash of the
+   wrong state in front of somebody looking at it. See FloorAssembly.tsx.
+
+   Every painted colour here is a SEMANTIC token (--on-dark*, --copper-bright).
+   The section sits on .wood-grain-dark, so the light-theme --ink would be
+   invisible on it; this is the same on-dark pairing .ef--onDark already uses.
+
+   The geometry is driven by three custom properties so one media query
+   rescales the whole illustration:
+     --fa-z   the explode distance in px at this breakpoint
+     --fa-f   per-layer factor (0–1), set per [data-i]
+     --fa-t   0 collapsed → 1 exploded. UNSET FALLS BACK TO 1, which is why
+              no-JS renders open.
+   ========================================================================== */
+
+.fa-section {
+  color: var(--on-dark);
+  overflow: hidden;
+}
+
+.fa-head {
+  max-width: 44rem;
+  margin-bottom: var(--space-xl);
+}
+
+.fa-kicker {
+  font-size: var(--fs-xs);
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--copper-bright);
+  margin: 0 0 var(--space-xs);
+}
+
+.fa-h2 {
+  font-size: var(--fs-2xl);
+  line-height: 1.15;
+  margin: 0 0 var(--space-md);
+  color: var(--on-dark);
+}
+
+.fa-lede {
+  color: var(--on-dark-muted);
+  line-height: 1.65;
+  margin: 0;
+  font-size: var(--fs-md);
+}
+
+/* ---- the stage ---- */
+.fa-stage {
+  --fa-z: 190px;
+  --fa-rot: -32deg;
+  --fa-w: min(520px, 68vw);
+  perspective: 1400px;
+  perspective-origin: 50% 40%;
+  padding: calc(var(--fa-z) * 0.62) 0 calc(var(--fa-z) * 0.3);
+  /* The section ground is .wood-grain-dark, a warm mid-brown. Five brown
+     layers on it read as one shape. This sinks the ground behind the stack so
+     the layers separate — it is contrast, not decoration. */
+  background: radial-gradient(ellipse 62% 58% at 50% 55%, rgba(0, 0, 0, 0.55), transparent 72%);
+}
+
+.fa-stage[data-collapsed='true'] {
+  --fa-t: 0;
+}
+
+.fa-stack {
+  position: relative;
+  transform-style: preserve-3d;
+  transform: rotateX(58deg) rotateZ(var(--fa-rot));
+  width: var(--fa-w);
+  margin: 0 auto;
+  aspect-ratio: 1.55;
+}
+
+.fa-layer {
+  position: absolute;
+  inset: 0;
+  border-radius: 10px;
+  border: 1px solid var(--on-dark-line);
+  box-shadow: 0 26px 46px rgba(0, 0, 0, 0.5);
+  transform-style: preserve-3d;
+  /* the fallback of 1 is what renders with no script */
+  transform: translateZ(calc(var(--fa-z) * var(--fa-f, 0) * var(--fa-t, 1)));
+  transition:
+    transform 0.85s cubic-bezier(0.2, 0.7, 0.2, 1),
+    opacity 0.4s ease,
+    filter 0.4s ease;
+  will-change: transform;
+}
+
+/* staggered so the stack peels rather than jumping as one piece */
+.fa-layer[data-i='0'] { --fa-f: 1;    transition-delay: 0.28s; }
+.fa-layer[data-i='1'] { --fa-f: 0.705; transition-delay: 0.21s; }
+.fa-layer[data-i='2'] { --fa-f: 0.442; transition-delay: 0.14s; }
+.fa-layer[data-i='3'] { --fa-f: 0.211; transition-delay: 0.07s; }
+.fa-layer[data-i='4'] { --fa-f: 0;     transition-delay: 0s; }
+
+/* 01 FINISH — a coating, so it is glaze rather than pigment. */
+.fa-layer[data-i='0'] {
+  background: linear-gradient(125deg, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0.04));
+  backdrop-filter: blur(1px);
+  -webkit-backdrop-filter: blur(1px);
+}
+
+/* 02 WEAR LAYER — the only layer that is a photograph. The crop is set inline
+   from grainTextureFor(species), so switching species repaints this one rule. */
+.fa-layer[data-i='1'] {
+  background-size: cover;
+  background-position: center;
+  background-blend-mode: multiply, normal;
+  box-shadow:
+    0 30px 52px rgba(0, 0, 0, 0.6),
+    inset 0 -6px 0 rgba(0, 0, 0, 0.35);
+}
+
+/* 03 FASTENING — cleats at a spacing, read end-on. */
+.fa-layer[data-i='2'] {
+  background:
+    repeating-linear-gradient(90deg, #6b6257 0 3px, transparent 3px 34px),
+    #2b2723;
+}
+
+/* 04 MOISTURE CONTROL — a membrane. */
+.fa-layer[data-i='3'] {
+  background: linear-gradient(160deg, #37444f, #1f272d);
+  box-shadow:
+    0 28px 48px rgba(0, 0, 0, 0.55),
+    inset 0 -4px 0 rgba(0, 0, 0, 0.35);
+}
+
+/* 05 SUBSTRATE — plywood or slab, and the thickest shadow because it carries. */
+.fa-layer[data-i='4'] {
+  background: linear-gradient(160deg, #6a5c4c, #403830);
+  box-shadow:
+    0 34px 60px rgba(0, 0, 0, 0.65),
+    inset 0 -7px 0 rgba(0, 0, 0, 0.4);
+}
+
+/* hovering or focusing a legend row picks its layer out of the stack */
+.fa-stack:has(.fa-layer[data-active='true']) .fa-layer:not([data-active='true']) {
+  opacity: 0.42;
+  filter: saturate(0.6);
+}
+
+.fa-layer[data-active='true'] {
+  box-shadow:
+    0 0 0 2px var(--copper-bright),
+    0 34px 60px rgba(0, 0, 0, 0.6);
+}
+
+/* ---- species ---- */
+.fa-species {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-sm) var(--space-md);
+  margin-bottom: var(--space-lg);
+}
+
+.fa-species-label {
+  font-size: var(--fs-xs);
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--on-dark-faint);
+}
+
+.fa-species-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-xs);
+}
+
+.fa-chip {
+  font: inherit;
+  font-size: var(--fs-sm);
+  padding: 0.4rem 0.85rem;
+  border-radius: 999px;
+  cursor: pointer;
+  background: color-mix(in srgb, var(--on-dark) 7%, transparent);
+  border: 1px solid var(--on-dark-line);
+  color: var(--on-dark-muted);
+  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
+}
+
+.fa-chip:hover {
+  background: color-mix(in srgb, var(--on-dark) 14%, transparent);
+  color: var(--on-dark);
+}
+
+.fa-chip[aria-pressed='true'] {
+  background: color-mix(in srgb, var(--copper-bright) 18%, transparent);
+  border-color: var(--copper-bright);
+  color: var(--on-dark);
+}
+
+.fa-species-note {
+  margin: 0;
+  font-size: var(--fs-sm);
+  color: var(--on-dark-muted);
+  flex-basis: 100%;
+}
+
+/* ---- legend ---- */
+.fa-legend {
+  list-style: none;
+  padding: 0;
+  margin: 0 0 var(--space-xl);
+  display: grid;
+  gap: var(--space-sm);
+}
+
+.fa-item {
+  display: grid;
+  grid-template-columns: 2rem 1fr;
+  gap: var(--space-md);
+  align-items: start;
+  padding: var(--space-sm) var(--space-sm) var(--space-md) 0;
+  border-bottom: 1px solid var(--on-dark-line);
+  border-radius: var(--radius-sm, 6px);
+  transition: background 0.2s ease;
+}
+
+.fa-item[data-active='true'] {
+  background: color-mix(in srgb, var(--on-dark) 5%, transparent);
+}
+
+.fa-n {
+  font-size: var(--fs-xs);
+  font-family: var(--font-mono);
+  color: var(--copper-bright);
+  padding-top: 0.2rem;
+}
+
+.fa-t {
+  font-weight: 600;
+  margin: 0 0 0.25rem;
+  color: var(--on-dark);
+}
+
+.fa-d {
+  margin: 0;
+  color: var(--on-dark-muted);
+  font-size: var(--fs-sm);
+  line-height: 1.6;
+}
+
+/* the question. This is the part a visitor screenshots and takes to the
+   competitor, which is exactly what it is for. */
+.fa-ask {
+  margin: 0.5rem 0 0;
+  font-size: var(--fs-sm);
+  line-height: 1.55;
+  color: var(--on-dark-muted);
+  border-left: 2px solid var(--copper-bright);
+  padding-left: var(--space-sm);
+}
+
+.fa-ask-label {
+  color: var(--copper-bright);
+  font-weight: 600;
+}
+
+.fa-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-md);
+}
+
+@media (max-width: 700px) {
+  .fa-stage {
+    --fa-z: 104px;
+    --fa-rot: -22deg;
+    --fa-w: min(360px, 72vw);
+  }
+  .fa-item {
+    grid-template-columns: 1.75rem 1fr;
+    gap: var(--space-sm);
+  }
+}
+
+/* The graphic never animates for somebody who asked it not to. It is already
+   in its final, readable state; this removes the transition so a species
+   switch or a legend hover changes it instantly rather than gliding. */
+@media (prefers-reduced-motion: reduce) {
+  .fa-layer {
+    transition: none;
+    transition-delay: 0s;
+  }
+}
