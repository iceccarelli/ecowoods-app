-.tlx-crumbs a { color: inherit; text-decoration: none; }
+/* 24px, because WCAG 2.5.8 AA says so and this was 18. Measured, on production,
+   by pnpm audit:rendered. inline-flex rather than a padding guess: the link keeps
+   its own text metrics and simply claims the height a thumb needs. The crumb row
+   is already 1.5rem clear of the title, so nothing moves. */
+.tlx-crumbs a {
+  color: inherit; text-decoration: none;
+  display: inline-flex; align-items: center; min-height: 24px;
+}
 .tlx-crumbs a:hover, .tlx-crumbs a:focus-visible { color: var(--copper-text); }
 .tlx-crumbs span[aria-hidden] { color: var(--muted-soft); }
 .tlx-title { font-family: var(--font-display); font-weight: 600; line-height: 1.12;
@@ -9208,7 +9215,9 @@ a:hover .ill-thumb-img, a:focus-visible .ill-thumb-img { transform: scale(1.03);
   gap: 0.4rem 1rem; }
