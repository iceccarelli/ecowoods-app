#!/usr/bin/env bash
#
# Pre-commit guard — nothing is committed directly onto the integration branch.
#
# Installed by: pnpm hooks:install
# Bypass once with: git commit --no-verify
#
# WHY THIS EXISTS — F-152, 2026-08-27
#
# Seventeen illustrations, a manifest registration, a regenerated import table
# and a clean 36-guard run were committed onto local `main` and never reached
# production. Nobody made a wrong decision. The failure was mechanical, and it is
# worth writing down in full because it will otherwise happen again:
#
#   1. A recovery procedure was pasted as one multi-line block. Its second line
#      was `git checkout -b feat/provenance-art`.
#   2. That branch already existed — an earlier attempt at the same procedure had
#      created it before failing for an unrelated reason.
#   3. `git checkout -b` on an existing branch exits 128 with
#      "fatal: a branch named '...' already exists" AND LEAVES YOU WHERE YOU WERE.
#      It does not switch. It does not stop the rest of a pasted block.
#   4. Every one of the next twenty commands ran on `main`. The build passed. All
#      36 guards passed. `git commit` reported `[main f1ed47d]` — the branch name
#      is right there in the output and reads as noise after a 300-line build log.
#   5. `git push -u origin feat/provenance-art` then pushed the STALE branch
#      pointer, which still equalled origin/main. Git reported
#      "Total 0 (delta 0), reused 0" and a new remote branch. That is a
#      successful push of nothing, and it looks exactly like a successful push.
#   6. `gh pr create` said "head branch main is the same as base branch main" —
#      the one honest error in the sequence, three commands too late.
#
# Every individual command behaved as documented. The composition was the defect.
#
# So: the integration branch does not accept commits. A procedure that lands work
# in the wrong place is now interrupted at step 4 rather than discovered at step 6,
# and the seventeen-command tail after it never runs on the wrong branch.
#
# WHAT THIS DOES NOT BLOCK
#
#   · fast-forwarding main from origin — that is not a commit
#   · `gh pr merge`, which happens on GitHub's servers
#   · a merge commit, which fires pre-merge-commit, not this hook
#   · a detached HEAD or an in-progress rebase, both of which are transient
#
set -euo pipefail

# A rebase, a cherry-pick, a revert or a bisect can legitimately replay commits
# while HEAD is on main. Those are transient states git tells us about.
GIT_DIR_PATH="$(git rev-parse --git-dir)"
for marker in rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG MERGE_HEAD; do
  [ -e "$GIT_DIR_PATH/$marker" ] && exit 0
done

BRANCH="$(git branch --show-current)"

# Detached HEAD returns empty. Nothing to protect.
[ -z "$BRANCH" ] && exit 0

case "$BRANCH" in
  main|master)
    # ── HYG-02 — THIS BLOCK USED TO REFUSE. IT NOW ONLY TELLS YOU. ──────────
    #
    # The premise above was that work reaches production through a pull
    # request. It does not, and has not for the whole life of this repository:
    # production is a `vercel --prod` run from a working tree, and
    # scripts/ship.sh checks out main at step 1 and pushes main at step 7. The
    # hook and the ship script therefore contradicted each other, and the only
    # way through was ECOWOODS_ALLOW_MAIN_COMMIT=1 on every single ship.
    #
    # That is the worst possible state for a guard. A rule you must override
    # every time is a rule you stop reading, and the one time it is right you
    # override it anyway, by reflex. It also cost a full hour on the MEAS-01
    # ship: `git commit --amend` was refused mid-sequence, the staged deletion
    # of a patch file was silently left behind, and that patch shipped to main
    # inside ba429cf.
    #
    # F-152 WAS REAL AND IS NOT BEING DISMISSED. What it actually was: a commit
    # landed on local main, `git push` reported success, and origin/main never
    # moved — because the push sent a branch nobody was watching while the
    # operator read the success line and deployed. The protection against that
    # is not "never commit on main". It is reading origin/main back OVER THE
    # NETWORK after the push, which scripts/ship.sh step 7 already does, and
    # which is strictly better than this block ever was: it catches the failure
    # on every branch, not just this one.
    #
    # So this warns and continues. Nothing is blocked. If you want the old
    # behaviour back it is one `exit 1` below the message.
    if [ "${ECOWOODS_ALLOW_MAIN_COMMIT:-}" = "1" ]; then
      exit 0
    fi
    cat >&2 <<MSG

▸ committing on '$BRANCH'.

  This is allowed and is now the normal way this repository works. Two things
  are worth doing afterwards, because a green local tree has misled this
  project before (F-140, F-152):

      git push origin $BRANCH
      git fetch origin && git log --oneline -1 origin/$BRANCH

  The second line reads the remote, not this tree. A push that reports success
  and moves nothing is the failure that made this hook exist, and it is the
  only check that sees it.

MSG
    exit 0
    ;;
esac

exit 0
