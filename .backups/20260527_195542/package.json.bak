{
  "name": "ecowoods-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev --filter=@ecowoods/web",
    "build": "turbo build --filter=@ecowoods/web",
    "build:web": "turbo build --filter=@ecowoods/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "next": "^15.5.18",
    "prettier": "^3.3.2",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
