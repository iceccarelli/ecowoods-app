+
+  const entities = await pool(universe, async (slug) => {
+    const [html, md, api] = await Promise.all([
+      get(`/service-areas/${slug}`),
+      get(`/service-areas/${slug}.md`),
+      get(`/api/v1/locations/${slug}`),
