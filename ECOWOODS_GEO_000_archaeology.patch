+    const byId = contradictions.reduce((a, c) => ((a[c.id] = (a[c.id] || 0) + 1), a), {});
+    console.log(`\n  contradictions: ${contradictions.length}`);
+    for (const [id, n] of Object.entries(byId)) console.log(`    ${id.padEnd(30)} ${n}`);
