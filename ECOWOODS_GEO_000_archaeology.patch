+  for (const e of entities) {
+    if (e.in_markets_service_area && e.html.status !== 200) add('SERVICE_AREA_WITHOUT_PAGE', e.slug, `markets.service_area lists it; /service-areas/${e.slug} → ${e.html.status}`);
