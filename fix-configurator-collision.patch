 /* ---- Ken Burns (alive on every image) ---- */
-.fc-kb { position: absolute; inset: 0; overflow: hidden; animation: fcFade 600ms ease; }
-.fc-kb img { will-change: transform; animation: kbDefault 12s ease-out both; }
-.fc-kb-0 img { animation: kb0 9s ease-out both; }
-.fc-kb-1 img { animation: kb1 9s ease-out both; }
-.fc-kb-2 img { animation: kb2 9s ease-out both; }
-.fc-kb-3 img { animation: kb3 9s ease-out both; }
+.gc-kb { position: absolute; inset: 0; overflow: hidden; animation: fcFade 600ms ease; }
+.gc-kb img { will-change: transform; animation: kbDefault 12s ease-out both; }
+.gc-kb-0 img { animation: kb0 9s ease-out both; }
+.gc-kb-1 img { animation: kb1 9s ease-out both; }
+.gc-kb-2 img { animation: kb2 9s ease-out both; }
+.gc-kb-3 img { animation: kb3 9s ease-out both; }
 @keyframes kbDefault { from { transform: scale(1.03); } to { transform: scale(1.11); } }
 @keyframes kb0 { from { transform: scale(1.03) translate(0,0); } to { transform: scale(1.13) translate(-2%,-1.5%); } }
 @keyframes kb1 { from { transform: scale(1.13) translate(1.5%,1%); } to { transform: scale(1.03) translate(0,0); } }
