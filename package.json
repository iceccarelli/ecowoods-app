{
  "name": "ecowoods-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev --filter=@ecowoods/web",
    "build": "turbo build --filter=@ecowoods/web",
    "build:web": "turbo build --filter=@ecowoods/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "verify:facts": "node scripts/verify-business-facts.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:papers": "node scripts/verify-papers.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:framework": "node scripts/verify-framework.mjs",
    "verify:client": "node scripts/verify-client-boundary.mjs",
    "verify:glossary": "node scripts/verify-glossary.mjs",
    "verify:figures": "node scripts/verify-figures.mjs",
    "verify:changelog": "node scripts/verify-changelog.mjs",
    "verify:market": "node scripts/verify-market.mjs",
    "verify:freshness": "node scripts/verify-freshness.mjs",
    "verify:images": "node scripts/verify-images.mjs",
    "verify:canonical": "node scripts/verify-canonical.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:indexnow": "node scripts/verify-indexnow.mjs",
    "verify:markdown": "node scripts/verify-markdown.mjs",
    "verify:services": "node scripts/verify-services.mjs",
    "verify:cities": "node scripts/verify-cities.mjs",
    "verify:manifests": "node scripts/verify-manifests.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:entity": "node scripts/verify-entity.mjs",
    "verify:reviews": "node scripts/verify-reviews.mjs",
    "verify:outreach": "node scripts/verify-outreach.mjs",
    "verify:live-images": "node scripts/verify-live-images.mjs",
    "verify:schema-figures": "node scripts/verify-schema-figures.mjs",
    "verify:domain": "node scripts/verify-domain-redirect.mjs",
    "verify:vercel": "node scripts/verify-vercel-config.mjs",
    "seo:audit": "node scripts/audit-current-state.mjs",
    "seo:pricing": "node scripts/verify-pricing-source.mjs",
    "seo:claims": "node scripts/verify-claims.mjs",
    "seo:topics": "node scripts/verify-topic-map.mjs",
    "seo:links": "node scripts/verify-links.mjs",
    "seo:schema": "node scripts/verify-schema.mjs",
    "seo:ai": "node scripts/audit-ai-discoverability.mjs",
    "seo:prompts": "node scripts/build-ai-prompts.mjs",
    "seo:crawl": "node scripts/crawl-site.mjs",
    "seo:domain": "node scripts/verify-domain-redirect.mjs",
    "seo:consistency": "pnpm verify:facts && pnpm seo:claims && pnpm seo:pricing && pnpm seo:topics && pnpm verify:entity && pnpm verify:canonical",
    "seo": "pnpm seo:pricing && pnpm seo:claims && pnpm seo:topics && pnpm seo:links && pnpm seo:schema && pnpm seo:ai",
    "seo:live": "pnpm seo:domain && pnpm seo:crawl",
    "truth": "bash scripts/state-of-truth.sh",
    "notify:indexnow": "node apps/web/scripts/notify-indexnow.mjs",
    "verify:live": "bash scripts/verify-live.sh",
    "images:brief": "node scripts/verify-images.mjs --prompts",
    "verify": "pnpm verify:facts && pnpm verify:migrations && pnpm verify:tokens && pnpm verify:schema && pnpm verify:papers && pnpm verify:links && pnpm verify:framework && pnpm verify:client && pnpm verify:glossary && pnpm verify:figures && pnpm verify:changelog && pnpm verify:market && pnpm verify:freshness && pnpm verify:images && pnpm verify:canonical && pnpm verify:sitemap && pnpm verify:indexnow && pnpm verify:markdown && pnpm verify:services && pnpm verify:cities && pnpm verify:manifests && pnpm verify:assets && pnpm verify:entity && pnpm verify:reviews && pnpm verify:outreach && pnpm verify:schema-figures && pnpm verify:vercel && pnpm seo:pricing && pnpm seo:claims && pnpm seo:topics && pnpm seo:ai",
    "audit": "bash scripts/audit-all.sh",
    "audit:full": "bash scripts/audit-all.sh --full",
    "audit:quick": "bash scripts/audit-all.sh --quick",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "ci:local": "pnpm verify && pnpm --filter @ecowoods/web exec prisma generate && pnpm --filter @ecowoods/web exec tsc --noEmit && pnpm --filter @ecowoods/web build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@types/node": "20.16.10",
    "next": "^15.5.18",
    "playwright": "^1.62.1",
    "prettier": "^3.3.2",
    "turbo": "^2.9.14",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-native": "0.81.5",
      "react-dom": "19.1.0",
      "@types/react": "19.2.16",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "bcryptjs",
      "@prisma/client",
      "prisma"
    ]
  }
}
