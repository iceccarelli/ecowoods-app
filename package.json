{
  "name": "ecowoods-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
"scripts": {
  "dev": "turbo dev --filter=@ecowoods/web",
  "build": "turbo build --filter='@ecowoods/*'",
  "build:web": "turbo build --filter=@ecowoods/web",
  "build:packages": "turbo build --filter='@ecowoods/*' --filter='!@ecowoods/web'",
  "lint": "turbo lint",
  "typecheck": "turbo typecheck",
  "format": "prettier --write .",
  "dev:mobile": "turbo dev --filter=@ecowoods/mobile",
  "dev:backend": "cd backend && uvicorn app.main:app --reload"
},
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.3.2",
    "@types/node": "20.16.10",
    "next": "^15.5.18"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
