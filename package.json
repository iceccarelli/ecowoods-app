{
  "name": "ecowoods-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Ecowoods — premium Toronto hardwood flooring marketing site | Perfectly integrated with full-stack job management platform (React Native + FastAPI + shared types + OData-aligned data layer)",
  "scripts": {
