{
  "name": "ecowoods-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "dev:web": "turbo run dev --filter=@ecowoods/web",
    "dev:mobile": "turbo run dev --filter=@ecowoods/mobile",
    "dev:admin": "turbo run dev --filter=@ecowoods/admin",
    "dev:backend": "cd backend && uvicorn app.main:app --reload"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.3.2",
    "@types/node": "20.16.10"
  },
  "engines": { "node": ">=18.18.0" }
}
