+}
+.wp-toc-label {
+  font-family: var(--font-mono);
+  font-size: 0.7rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--muted);
+  margin: 0 0 0.75rem;
+}
+.wp-toc ol { list-style: none; margin: 0; padding: 0; counter-reset: wp; }
+.wp-toc li { counter-increment: wp; margin: 0; }
+.wp-toc a {
+  display: flex;
+  gap: 0.6rem;
+  align-items: baseline;
+  min-height: 44px;
+  padding: 0.35rem 0 0.35rem 0.75rem;
+  margin-left: -0.75rem;
+  color: var(--ink-soft);
+  text-decoration: none;
+  font-size: 0.92rem;
+  line-height: 1.4;
+  border-left: 2px solid transparent;
+}
+.wp-toc a::before {
+  content: counter(wp, decimal-leading-zero);
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  color: var(--muted-soft);
+}
+.wp-toc a:hover, .wp-toc a:focus-visible {
+  color: var(--copper-text);
+  border-left-color: var(--copper);
+}
+
+.wp-article { min-width: 0; max-width: 72ch; }
+.wp-section { scroll-margin-top: calc(var(--header-h, 72px) + 1.5rem); }
+.wp-section + .wp-section { margin-top: 2.75rem; }
+.wp-article h2 {
+  font-family: var(--font-display);
+  font-weight: 600;
+  font-size: 1.55rem;
+  line-height: 1.25;
+  margin: 0 0 0.9rem;
+}
+.wp-article p { color: var(--ink-soft); line-height: 1.75; margin: 0 0 1.1rem; }
+
+.wp-bullets, .wp-steps { color: var(--ink-soft); line-height: 1.7; margin: 0 0 1.25rem; }
+.wp-bullets { list-style: none; padding: 0; }
+.wp-bullets li { padding: 0.2rem 0 0.2rem 1.4rem; position: relative; }
+.wp-bullets li::before {
+  content: '';
+  position: absolute;
+  left: 0.15rem; top: 0.85rem;
+  width: 6px; height: 6px;
+  border-radius: 50%;
+  background: var(--copper-text);
+}
+.wp-steps { padding-left: 1.35rem; }
+.wp-steps li { padding: 0.2rem 0; }
+.wp-steps li::marker { color: var(--copper-text); font-weight: 600; }
+
+/* Scrolls at EVERY width, not below a breakpoint — the article column is the
+   constraint, not the viewport. Same reasoning as F-29. */
+.wp-table-wrap {
+  overflow-x: auto;
+  margin: 0 0 1.5rem;
+  border: 1px solid var(--line);
+  border-radius: 10px;
+}
+.wp-table-wrap:focus-visible { outline: 2px solid var(--copper); outline-offset: 2px; }
+.wp-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
+.wp-table caption {
+  caption-side: top;
+  text-align: left;
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--muted);
+  padding: 0.85rem 1rem 0.6rem;
+}
+.wp-table th, .wp-table td {
+  padding: 0.7rem 1rem;
+  text-align: left;
+  border-top: 1px solid var(--line);
+  vertical-align: top;
+}
+.wp-table thead th {
+  border-top: 0;
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--muted);
+  background: var(--surface-1);
+}
+.wp-table tbody th { font-weight: 600; color: var(--ink); }
+.wp-table tbody td { color: var(--ink-soft); }
+
+.wp-callout {
+  border-left: 3px solid var(--copper-surface);
+  background: var(--surface-1);
+  border-radius: 0 10px 10px 0;
+  padding: 1.1rem 1.25rem;
+  margin: 0 0 1.5rem;
+}
+.wp-callout-label {
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--copper-text);
+  margin: 0 0 0.4rem !important;
+}
+.wp-callout p:last-child { margin-bottom: 0 !important; color: var(--ink); }
