 }
+
+/* ============================================================
+   TECHNICAL PAPERS (.wp-*) — /papers and /papers/<slug>
+   ------------------------------------------------------------
+   Sits on the .tlx-* editorial system, not .shell/.section: these are
+   documents that get read, which is the rule in DESIGN_SYSTEM.md. Everything
+   here composes with .tlx-page / .tlx-hero / .tlx-section rather than
+   redefining them — a third design language is the bug, not the goal.
+   Semantic tokens only.
+   ============================================================ */
+
+.wp-hero-sub {
+  font-family: var(--font-display);
+  font-size: 1.25rem;
+  line-height: 1.35;
+  color: var(--copper-text);
+  margin: 0.35rem 0 0.9rem;
+}
+.wp-hero-actions { margin: 1.75rem 0 0; }
+
+/* ── index list ── */
+.wp-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
+.wp-item {
+  display: grid;
+  gap: 1.5rem;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
+  align-items: start;
+  padding: 1.75rem;
+  background: var(--surface-1);
+  border: 1px solid var(--line);
+  border-radius: 14px;
+}
+@media (max-width: 767px) {
+  .wp-item { grid-template-columns: 1fr; padding: 1.35rem; }
+}
+.wp-item-main { min-width: 0; }
+.wp-item-title { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem;
+  line-height: 1.2; margin: 0.45rem 0 0.2rem; }
+.wp-item-title a { color: inherit; text-decoration: none; }
+.wp-item-title a:hover, .wp-item-title a:focus-visible { color: var(--copper-text); }
+.wp-item-sub { color: var(--copper-text); font-size: 0.95rem; margin: 0 0 0.65rem; }
+.wp-item-abstract { color: var(--ink-soft); line-height: 1.6; margin: 0; max-width: 62ch; }
+
+.wp-topics { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem;
+  margin: 1rem 0 0; padding: 0; }
+.wp-topics li {
+  font-family: var(--font-mono);
+  font-size: 0.68rem;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--muted);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-full);
+  padding: 0.3rem 0.7rem;
+}
+
+.wp-item-side { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
+.wp-specs { grid-template-columns: 1fr 1fr; }
+
+/* ── buttons. min-height 44px from the start: F-60 was three controls that
+      were only ever styled inside one media query, or with padding: 0. ── */
+.wp-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.45rem;
+  min-height: 44px;
+  padding: 0.7rem 1.1rem;
+  border-radius: var(--radius-md);
+  border: 1px solid transparent;
+  background: var(--copper-surface);
+  color: var(--on-copper);
+  font-weight: 600;
+  font-size: var(--fs-sm);
+  text-align: center;
+  text-decoration: none;
+  transition: filter 160ms ease, border-color 160ms ease;
+}
+.wp-btn:hover, .wp-btn:focus-visible { filter: brightness(1.06); }
+.wp-btn:focus-visible { outline: 2px solid var(--copper); outline-offset: 2px; }
+.wp-btn--ghost {
+  background: transparent;
+  color: var(--copper-text);
+  border-color: var(--line-strong);
+}
+.wp-btn--ghost:hover, .wp-btn--ghost:focus-visible { border-color: var(--copper); }
+.wp-ext { font-size: 0.9em; }
+
+/* Visually hidden, still read aloud — the "(opens in a new tab)" every PDF
+   link needs and no sighted user should have to see. */
+.wp-sr {
+  position: absolute;
+  width: 1px; height: 1px;
+  padding: 0; margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* ── detail: contents rail + article ── */
+.wp-layout {
+  display: grid;
+  gap: clamp(2rem, 4vw, 3.5rem);
+  grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
+  align-items: start;
+  padding-top: 3rem;
+  padding-bottom: 3rem;
+  max-width: 1080px;
+}
+@media (max-width: 1023px) {
+  .wp-layout { grid-template-columns: 1fr; }
+}
+
+.wp-toc { position: sticky; top: calc(var(--header-h, 72px) + 1.5rem); min-width: 0; }
+@media (max-width: 1023px) {
+  .wp-toc {
+    position: static;
+    border: 1px solid var(--line);
+    border-radius: 12px;
+    padding: 1.1rem 1.25rem;
+    background: var(--surface-1);
