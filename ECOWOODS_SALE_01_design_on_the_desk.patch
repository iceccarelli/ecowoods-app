+            <dd>
+              {design.room.lightLevel} light · {design.room.wallUndertone} walls ·{' '}
+              {design.room.existingFloorTone} existing floor
+            </dd>
+          </div>
+        )}
+        {design.budgetCad && (
+          <div className="detail-row">
+            <dt>Budget they typed</dt>
+            <dd>
