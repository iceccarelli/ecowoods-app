From 1a47b3dd6928dec96b612ba22b3289a6420d6db2 Mon Sep 17 00:00:00 2001
From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Sun, 19 Jul 2026 13:47:03 +0000
Subject: [PATCH 1/2] perf+seo(web): sitemap, robots (AI crawlers welcomed),
 code-split ChatWidget

- app/robots.ts + app/sitemap.ts (native Next, zero deps): the site had neither,
  so crawlers had no map and no policy. robots explicitly allows GPTBot,
  ClaudeBot, PerplexityBot, Google-Extended etc. so AI agents can read and cite
  the site, and points to the sitemap.
- ChatWidget is now dynamic() (ssr:false) via ChatWidgetLoader, so its ~200
  lines of JS load in a separate client chunk after hydration instead of
  blocking first paint on every page.
---
 apps/web/app/components/ChatWidgetLoader.tsx | 15 ++++++++++++
 apps/web/app/layout.tsx                      |  4 ++--
 apps/web/app/robots.ts                       | 24 ++++++++++++++++++++
 apps/web/app/sitemap.ts                      | 19 ++++++++++++++++
 4 files changed, 60 insertions(+), 2 deletions(-)
 create mode 100644 apps/web/app/components/ChatWidgetLoader.tsx
 create mode 100644 apps/web/app/robots.ts
 create mode 100644 apps/web/app/sitemap.ts

diff --git a/apps/web/app/components/ChatWidgetLoader.tsx b/apps/web/app/components/ChatWidgetLoader.tsx
new file mode 100644
index 0000000..849ac71
--- /dev/null
+++ b/apps/web/app/components/ChatWidgetLoader.tsx
@@ -0,0 +1,15 @@
+'use client';
+
+import dynamic from 'next/dynamic';
+
+/**
+ * Defers the ChatWidget into its own client chunk so its ~200 lines of JS never
+ * block first paint or initial hydration. ssr:false: an interactive chat has no
+ * SSR value, and skipping it shrinks the server-rendered HTML too. The launcher
+ * still appears right after hydration.
+ */
+const ChatWidget = dynamic(() => import('./ChatWidget'), { ssr: false });
+
+export default function ChatWidgetLoader() {
+  return <ChatWidget />;
+}
diff --git a/apps/web/app/layout.tsx b/apps/web/app/layout.tsx
index ba89511..1e2e2bd 100644
--- a/apps/web/app/layout.tsx
+++ b/apps/web/app/layout.tsx
@@ -46,7 +46,7 @@ export const viewport: Viewport = {
   ],
 };
 
-import ChatWidget from "./components/ChatWidget";
+import ChatWidgetLoader from "./components/ChatWidgetLoader";
 
 const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? 'https://ecowoods.ca';
 const DESCRIPTION =
@@ -125,7 +125,7 @@ export default function RootLayout({ children }: { children: ReactNode }) {
           <Header />
           <main role="main" id="main">{children}</main>
           <SiteFooter />
-          <ChatWidget />
+          <ChatWidgetLoader />
           <ConversionRail />
         </Providers>
       </body>
diff --git a/apps/web/app/robots.ts b/apps/web/app/robots.ts
new file mode 100644
index 0000000..f8b58dc
--- /dev/null
+++ b/apps/web/app/robots.ts
@@ -0,0 +1,24 @@
+import type { MetadataRoute } from 'next';
+
+const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? 'https://ecowoods.ca';
+
+/**
+ * robots.txt — generated by Next. Explicitly welcomes general search crawlers
+ * AND the major AI agents (so ChatGPT, Claude, Perplexity, Gemini etc. can read
+ * and cite the site), while keeping private surfaces out of the index.
+ */
+export default function robots(): MetadataRoute.Robots {
+  return {
+    rules: [
+      {
+        userAgent: '*',
+        allow: '/',
+        disallow: ['/admin', '/mypage', '/api/', '/login', '/register', '/verify-email'],
+      },
+      // Named allow for AI crawlers — some ignore '*'; naming them removes doubt.
+      { userAgent: ['GPTBot', 'OAI-SearchBot', 'ChatGPT-User', 'ClaudeBot', 'Claude-Web', 'anthropic-ai', 'PerplexityBot', 'Google-Extended', 'Applebot-Extended', 'CCBot'], allow: '/' },
+    ],
+    sitemap: `${SITE_URL}/sitemap.xml`,
+    host: SITE_URL,
+  };
+}
diff --git a/apps/web/app/sitemap.ts b/apps/web/app/sitemap.ts
new file mode 100644
index 0000000..c0a492f
--- /dev/null
+++ b/apps/web/app/sitemap.ts
@@ -0,0 +1,19 @@
+import type { MetadataRoute } from 'next';
+
+const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? 'https://ecowoods.ca';
+
+/**
+ * sitemap.xml — generated by Next. The site is a single indexable landing page;
+ * listing it with a fresh lastModified and high priority tells crawlers what to
+ * fetch first. Add real sub-pages here as they ship.
+ */
+export default function sitemap(): MetadataRoute.Sitemap {
+  return [
+    {
+      url: SITE_URL,
+      lastModified: new Date(),
+      changeFrequency: 'weekly',
+      priority: 1,
+    },
+  ];
+}
-- 
2.43.0


